// Обработчики формы документа "Наряды".

@Обработчик
метод ПередЗакрытием(Событие: ПараметрыЗакрытияФормы)
    // Если обращение уже занято другим нарядом — закрываем без вопроса о несохранённых данных.
    если Объект.Обращение != Неопределено и ЕстьНарядПоОбращению(Объект.Обращение, Объект.Ссылка)
        Событие.РежимЗакрытияФормы = РежимЗакрытияФормы.Закрыть
    ;
;

@Обработчик
метод ПослеСоздания()
    ЗакрытьЕслиОбращениеЗанято()
;

метод ЗакрытьЕслиОбращениеЗанято()
    если Объект.Обращение == Неопределено
        возврат
    ;

    если ЕстьНарядПоОбращению(Объект.Обращение, Объект.Ссылка)
        Диалог.Вопрос(ТекстЗанятогоОбращения(Объект.Обращение), [СтандартнаяКнопкаДиалога.Ок])
        этот.Закрыть()
    ;
;

@НаСервере @ДоступноСКлиента
статический метод ТекстЗанятогоОбращения(Обращение: Обращения.Ссылка): Строка
    знч Исходное = Обращение.ЗагрузитьОбъект()
    если Исходное == Неопределено
        возврат "По этому обращению уже введён наряд!"
    ;

    возврат "По обращению №" + Исходное.Номер
        + " от " + Исходное.Дата.Представление()
        + " уже введён наряд!"
;

@НаСервере @ДоступноСКлиента
статический метод ЕстьНарядПоОбращению(Обращение: Обращения.Ссылка, СвояСсылка: Наряды.Ссылка?): Булево
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            Наряды
        ГДЕ
            Обращение == %Обращение
    }

    для Строка из Запрос.Выполнить()
        если СвояСсылка == Неопределено
            возврат Истина
        ;
        если не (Строка.Ссылка == СвояСсылка)
            возврат Истина
        ;
    ;

    возврат Ложь
;

метод ЗаписатьДокумент(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Объект.Проведён = Ложь
    этот.Записать()
;

метод ПровестиДокумент(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Объект.Проведён = Истина
    этот.Записать()
;

метод ПровестиИЗакрыть(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Объект.Проведён = Истина
    этот.Записать()
    этот.Закрыть()
;

метод ОтменитьПроведение(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Объект.Проведён = Ложь
    этот.Записать()
;


метод ОбращениеИзменено(Источник: ПолеВвода<Обращения.Ссылка?>, Событие: СобытиеПриИзменении<неизвестно>)
    если Объект.Обращение == Неопределено
        возврат
    ;

    знч Данные = ДанныеОбращения(Объект.Обращение)
    если Данные == Неопределено
        возврат
    ;

    Объект.Контрагент = (Данные.Получить(0) как Контрагенты.Ссылка?)
    Объект.Исполнитель = (Данные.Получить(1) как Сотрудники.Ссылка?)
    Объект.ОписаниеРабот = (Данные.Получить(2) как Строка?) ?? ""
    Объект.Договор = Неопределено
;

@НаСервере @ДоступноСКлиента
статический метод ДанныеОбращения(Обращение: Обращения.Ссылка): Массив<Объект?>?
    знч Исходное = Обращение.ЗагрузитьОбъект()
    если Исходное == Неопределено
        возврат Неопределено
    ;

    знч Результат = новый Массив<Объект?>()
    Результат.Добавить(Исходное.Контрагент)
    Результат.Добавить(Исходное.Исполнитель)
    Результат.Добавить(Исходное.ОписаниеПроблемыСоСловЗаказчика)
    возврат Результат
;

метод ДоговорыДляКонтрагента(Источник: ПолеВвода<Договоры.Ссылка?>, Событие: СобытиеПриАвтоПодборе)
    Событие.ЗначенияАвтоПодбора = ЗагрузитьДоговорыДляКонтрагента(Объект.Контрагент)
;

@НаСервере @ДоступноСКлиента
статический метод ЗагрузитьДоговорыДляКонтрагента(Контрагент: Контрагенты.Ссылка?): Массив<ЭлементСпискаЗначений<Объект?>>
    знч Результат = новый Массив<ЭлементСпискаЗначений<Объект?>>()
    если Контрагент == Неопределено
        возврат Результат
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            Договоры
        ГДЕ
            Контрагент == %Контрагент
    }
    для Строка из Запрос.Выполнить()
        Результат.Добавить(новый ЭлементСпискаЗначений<Объект?>(Строка.Ссылка, Строка.Ссылка.Представление()))
    ;
    возврат Результат
;

@НаСервере @ДоступноСКлиента
статический метод СохранитьДокумент(Данные: Наряды.Объект, Провести: Булево)
    Данные.Проведён = Провести
    Данные.Записать()
;

@НаСервере @ДоступноСКлиента
статический метод НастройкиДоговора(Контрагент: Контрагенты.Ссылка?): НастройкиВводаСсылок
    знч Элемент = новый ЭлементФильтра()
    Элемент.Поле = "Контрагент"
    Элемент.ВидСравнения = ВидСравнения.Равно
    Элемент.Значение = Контрагент

    знч Группа = новый ГруппаЭлементовФильтра()
    Группа.ВидГруппы = ВидГруппыЭлементовФильтра.ГруппаИ
    Группа.Использовать = Истина
    Группа.Элементы.Добавить(Элемент)

    знч Настройки = новый НастройкиВводаСсылки()
    Настройки.Фильтр = Группа

    знч ПоТипу = новый Соответствие<Тип<Сущность.Ключ>, НастройкиВводаСсылки>()
    ПоТипу.Вставить(Тип<Договоры.Ссылка>, Настройки)

    знч Результат = новый НастройкиВводаСсылок()
    Результат.НастройкиПоТипу = ПоТипу
    возврат Результат
;

метод ПометитьНаУдаление(Источник: Кнопка, Событие: СобытиеПриНажатии)
    знч Причина = ПроверитьПометку(Объект.Ссылка)
    если Причина != ""
        Диалог.Вопрос(Причина, [СтандартнаяКнопкаДиалога.Ок])
        возврат
    ;
    ПометитьДокумент(Объект.Ссылка)
    этот.Закрыть()
;

@НаСервере @ДоступноСКлиента
статический метод ПроверитьПометку(Ссылка: Наряды.Ссылка?): Строка
    если Ссылка == Неопределено
        возврат ""
    ;
    знч Об = Ссылка.ЗагрузитьОбъект()
    если Об == Неопределено или Об.Обращение == Неопределено
        возврат ""
    ;
    знч Исходное = Об.Обращение.ЗагрузитьОбъект()
    если Исходное == Неопределено
        возврат ""
    ;
    если не Исходное.ПометкаУдаления
        возврат "Нельзя удалить наряд: сначала пометьте на удаление обращение"
    ;
    возврат ""
;

@НаСервере @ДоступноСКлиента
статический метод ПометитьДокумент(Ссылка: Наряды.Ссылка?)
    если Ссылка == Неопределено
        возврат
    ;
    знч Об = Ссылка.ЗагрузитьОбъект()
    если Об == Неопределено
        возврат
    ;
    если Об.Проведён
        Об.Проведён = Ложь
        Об.Записать()
    ;
    Наряды.УстановитьПометкуУдаления(Ссылка, Истина)
;
