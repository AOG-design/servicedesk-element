// Обработчики документа "Наряды".

@Обработчик
метод ПриСозданииНаОсновании(Основание: Обращения.Ссылка)
    // По одному обращению допускается только один наряд.
    если ЕстьДругойНаряд(Основание, Неопределено)
        выбросить новый ИсключениеВалидации(ТекстЗанятогоОбращения(Основание), ОтображатьСообщениеОбОшибке = Истина)
    ;

    Обращение = Основание

    знч Исходное = Основание.ЗагрузитьОбъект()
    если Исходное == Неопределено
        возврат
    ;

    Контрагент = Исходное.Контрагент
    Исполнитель = Исходное.Исполнитель
    ОписаниеРабот = Исходное.Описание
;

@Обработчик
метод ПередЗаписью(До: Наряды.Данные, ПараметрыЗаписи: Наряды.ПараметрыЗаписи)
    если Обращение != Неопределено и ЕстьДругойНаряд(Обращение, Ссылка)
        выбросить новый ИсключениеВалидации(ТекстЗанятогоОбращения(Обращение), ОтображатьСообщениеОбОшибке = Истина)
    ;

    если Договор == Неопределено
        возврат
    ;

    знч ДоговорОбъект = Договор.ЗагрузитьОбъект()
    если ДоговорОбъект == Неопределено
        возврат
    ;

    если ДоговорОбъект.Контрагент != Контрагент
        выбросить новый ИсключениеВалидации(
            "Выбранный договор принадлежит другому контрагенту",
            ОтображатьСообщениеОбОшибке = Истина)
    ;
;

@Обработчик
метод ПослеЗаписи(До: Наряды.Данные, ПараметрыЗаписи: Наряды.ПараметрыЗаписи)
    если Проведён
        ЗаписатьОтработанноеВремя()
        ЗаписатьМатериалы()
        ЗаписатьСтатусОбращения()
    иначе
        ОчиститьДвижения()
    ;
;

метод ОчиститьДвижения()
    знч Время = новый ОтработанноеВремя.НаборЗаписей()
    Время.Фильтр.Установить(Регистратор = Ссылка)
    Время.Записать()

    знч МатериалыДвижения = новый ИспользованныеМатериалы.НаборЗаписей()
    МатериалыДвижения.Фильтр.Установить(Регистратор = Ссылка)
    МатериалыДвижения.Записать()

    если Обращение != Неопределено
        знч Статусы = новый СтатусыОбращений.НаборЗаписей()
        Статусы.Фильтр.Установить(Документ = Обращение)
        Статусы.Записать()
    ;
;

метод ЗаписатьОтработанноеВремя()
    знч Набор = новый ОтработанноеВремя.НаборЗаписей()
    Набор.Фильтр.Установить(Регистратор = Ссылка)

    знч МинутыПоНаряду = Часы * 60
    если МинутыПоНаряду != 0
        Набор.ДобавитьЗапись(
            Период = Дата,
            ВидЗаписи = ВидЗаписиРегистраНакопления.Приход,
            Договор = Договор,
            Контрагент = Контрагент,
            Исполнитель = Исполнитель,
            ДокументПартии = Ссылка,
            Минуты = МинутыПоНаряду)
    ;
    Набор.Записать()
;

метод ЗаписатьМатериалы()
    знч Набор = новый ИспользованныеМатериалы.НаборЗаписей()
    Набор.Фильтр.Установить(Регистратор = Ссылка)

    для Строка из Материалы
        Набор.ДобавитьЗапись(
            Период = Дата,
            ВидЗаписи = ВидЗаписиРегистраНакопления.Приход,
            Номенклатура = Строка.Номенклатура,
            Исполнитель = Исполнитель,
            Количество = Строка.Количество)
    ;
    Набор.Записать()
;

метод ЗаписатьСтатусОбращения()
    если Обращение == Неопределено
        возврат
    ;

    знч Набор = новый СтатусыОбращений.НаборЗаписей()
    Набор.Фильтр.Установить(Документ = Обращение)
    Набор.ДобавитьЗапись(
        Документ = Обращение,
        Статус = СтатусОбращения.ВРаботе,
        Сотрудник = Исполнитель,
        ДатаИзменения = Дата)
    Набор.Записать()
;

// Возвращает Истина, если по обращению уже есть наряд (кроме собственного).
метод ЕстьДругойНаряд(Обращение: Обращения.Ссылка, СвояСсылка: Наряды.Ссылка?): Булево
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            Наряды
        ГДЕ
            Обращение == %Обращение
    }

    для Строка из Запрос.Выполнить()
        если СвояСсылка == Неопределено
            возврат Истина
        ;
        если не (Строка.Ссылка == СвояСсылка)
            возврат Истина
        ;
    ;

    возврат Ложь
;

// Текст сообщения о занятом обращении.
метод ТекстЗанятогоОбращения(Обращение: Обращения.Ссылка): Строка
    знч Исходное = Обращение.ЗагрузитьОбъект()
    если Исходное == Неопределено
        возврат "По этому обращению уже введён наряд!"
    ;

    возврат "По обращению №" + Исходное.Номер
        + " от " + Исходное.Дата.Представление()
        + " уже введён наряд!"
;