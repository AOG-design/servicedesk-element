// Обработчики документа "Обращения".

@Обработчик
метод ПослеЗаписи(До: Обращения.Данные, ПараметрыЗаписи: Обращения.ПараметрыЗаписи)
    // Регистрация статуса обращения на момент записи.
    знч Набор = новый СтатусыОбращений.НаборЗаписей()
    Набор.Фильтр.Установить(Документ = Ссылка)
    Набор.ДобавитьЗапись(
        Период = Дата,
        Документ = Ссылка,
        Статус = Статус,
        Сотрудник = Исполнитель)
    Набор.Записать()
;
