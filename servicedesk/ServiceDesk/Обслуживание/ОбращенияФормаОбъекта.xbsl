// Обработчики формы документа "Обращения".

метод ЗаписатьДокумент(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Объект.Проведён = Ложь
    этот.Записать()
;

метод ПровестиДокумент(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Объект.Проведён = Истина
    этот.Записать()
;

метод ПровестиИЗакрыть(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Объект.Проведён = Истина
    этот.Записать()
    этот.Закрыть()
;

метод ОтменитьПроведение(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Объект.Проведён = Ложь
    этот.Записать()
;


@НаСервере @ДоступноСКлиента
статический метод СохранитьДокумент(Данные: Обращения.Объект, Провести: Булево)
    Данные.Проведён = Провести
    Данные.Записать()
;

метод ПометитьНаУдаление(Источник: Кнопка, Событие: СобытиеПриНажатии)
    ПометитьДокумент(Объект.Ссылка)
    этот.Закрыть()
;

@НаСервере @ДоступноСКлиента
статический метод ПометитьДокумент(Ссылка: Обращения.Ссылка?)
    если Ссылка == Неопределено
        возврат
    ;
    знч Об = Ссылка.ЗагрузитьОбъект()
    если Об == Неопределено
        возврат
    ;
    если Об.Проведён
        Об.Проведён = Ложь
        Об.Записать()
    ;
    Обращения.УстановитьПометкуУдаления(Ссылка, Истина)
;

// ---------------------- контактные лица ----------------------

метод КонтактноеЛицоИзменено(Источник: ПолеВвода<КонтактныеЛица.Ссылка?>, Событие: СобытиеПриИзменении<неизвестно>)
    если Объект.КонтактноеЛицо == Неопределено
        возврат
    ;

    знч Данные = ДанныеКонтактногоЛица(Объект.КонтактноеЛицо)
    если Данные == Неопределено
        возврат
    ;

    Объект.КодГорода = (Данные.Получить(0) как Строка?) ?? ""
    Объект.ТелефонКонтактногоЛица = (Данные.Получить(1) как Строка?) ?? ""
    Объект.ДобавочныйНомер = (Данные.Получить(2) как Строка?) ?? ""
    Объект.МобильныйТелефонКонтактногоЛица = (Данные.Получить(3) как Строка?) ?? ""
;

@НаСервере @ДоступноСКлиента
статический метод ДанныеКонтактногоЛица(Ссылка: КонтактныеЛица.Ссылка?): Массив<Строка?>?
    если Ссылка == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            КодГорода,
            Телефон,
            ДобавочныйНомер,
            МобильныйТелефон
        ИЗ
            КонтактныеЛица
        ГДЕ
            Ссылка == %Ссылка
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат Неопределено
    ;

    знч Результат = новый Массив<Строка?>()
    Результат.Добавить(Строка.КодГорода)
    Результат.Добавить(Строка.Телефон)
    Результат.Добавить(Строка.ДобавочныйНомер)
    Результат.Добавить(Строка.МобильныйТелефон)
    возврат Результат
;

@НаСервере @ДоступноСКлиента
статический метод НастройкиКонтактныхЛиц(Контрагент: Контрагенты.Ссылка?): НастройкиВводаСсылок
    знч Элемент = новый ЭлементФильтра()
    Элемент.Поле = "Контрагент"
    Элемент.ВидСравнения = ВидСравнения.Равно
    Элемент.Значение = Контрагент

    знч Группа = новый ГруппаЭлементовФильтра()
    Группа.ВидГруппы = ВидГруппыЭлементовФильтра.ГруппаИ
    Группа.Использовать = Истина
    Группа.Элементы.Добавить(Элемент)

    знч Настройки = новый НастройкиВводаСсылки()
    Настройки.Фильтр = Группа

    знч ПоТипу = новый Соответствие<Тип<Сущность.Ключ>, НастройкиВводаСсылки>()
    ПоТипу.Вставить(Тип<КонтактныеЛица.Ссылка>, Настройки)

    знч Результат = новый НастройкиВводаСсылок()
    Результат.НастройкиПоТипу = ПоТипу
    возврат Результат
;
