// Заполнение реквизитов контрагента по ИНН через Dadata.
// Ключ API: https://dadata.ru/profile/#info

@НаСервере
структура ОтветDadata
    пер suggestions: Массив<ПодсказкаDadata>;

@НаСервере
структура ПодсказкаDadata
    пер data: ДанныеDadata;

@НаСервере
структура ДанныеDadata
    пер kpp: Строка?
    пер ogrn: Строка?
    пер name: ИмяDadata?
    пер address: АдресDadata?
    пер state: СостояниеDadata?;

@НаСервере
структура ИмяDadata
    пер full_with_opf: Строка?;

@НаСервере
структура АдресDadata
    пер value: Строка?;

@НаСервере
структура СостояниеDadata
    пер status: Строка?;

метод ЗаполнитьПоИНН(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если Объект.ИНН == ""
        возврат
    ;

    знч Данные = ЗапроситьРеквизитыПоИНН(Объект.ИНН)
    если Данные == Неопределено
        возврат
    ;

    Объект.ПолноеНаименование = Данные.Получить(0)
    Объект.КПП = Данные.Получить(1)
    Объект.ОГРН = Данные.Получить(2)
    Объект.ЮридическийАдрес = Данные.Получить(3)
    Объект.СтатусКонтрагента = Данные.Получить(4)
;

@НаСервере @ДоступноСКлиента
статический метод ЗапроситьРеквизитыПоИНН(ИНН: Строка): Массив<Строка>?
    знч Тело = "{\"query\": \"" + ИНН + "\"}"

    знч Ответ = КлиентHttp
        .ЗапросPost("https://suggestions.dadata.ru/suggestions/api/4_1/rs/findById/party")
        .УстановитьЗаголовок("Authorization", "Token " + ТокенDadata())
        .УстановитьЗаголовок("Accept", "application/json")
        .УстановитьТипСодержимого("application/json")
        .УстановитьТело(Тело)
        .Выполнить()

    если Ответ.КодСтатуса != 200
        возврат Неопределено
    ;

    знч Настройки = новый НастройкиЧтенияОбъектовJson()
    Настройки.ИгнорироватьНеизвестныеСвойства = Истина

    знч Результат = СериализацияJson.ПрочитатьОбъект<ОтветDadata>(Ответ.Тело, Настройки)
    знч Подсказка = Результат.suggestions.ПервыйИлиНеопределено()
    если Подсказка == Неопределено
        возврат Неопределено
    ;

    знч Данные = Подсказка.data
    знч Реквизиты = новый Массив<Строка>()
    Реквизиты.Добавить(Данные.name?.full_with_opf ?? "")
    Реквизиты.Добавить(Данные.kpp ?? "")
    Реквизиты.Добавить(Данные.ogrn ?? "")
    Реквизиты.Добавить(Данные.address?.value ?? "")
    Реквизиты.Добавить(Данные.state?.status ?? "")
    возврат Реквизиты
;

@НаСервере
статический метод ТокенDadata(): Строка
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            ТокенDadata
        ИЗ
            НастройкиСистемы
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат ""
    ;
    возврат Строка.ТокенDadata ?? ""
;

метод Восстановить(Источник: Кнопка, Событие: СобытиеПриНажатии)
    СнятьПометку(Объект.Ссылка)
    этот.Закрыть()
;

@НаСервере @ДоступноСКлиента
статический метод СнятьПометку(Ссылка: Контрагенты.Ссылка?)
    если Ссылка == Неопределено
        возврат
    ;
    Контрагенты.УстановитьПометкуУдаления(Ссылка, Ложь)
;
