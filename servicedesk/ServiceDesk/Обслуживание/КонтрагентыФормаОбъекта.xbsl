// Токен Dadata: https://dadata.ru/profile/#info
// Подставьте свой ключ вместо строки ниже.
@ВПодсистеме
метод ТокенDadata(): Строка
    возврат "c7e292e880f938e3f07bb42029d28dfefab82348"
;

структура ОтветDadata
    пер suggestions: Массив<ПодсказкаDadata>;

структура ПодсказкаDadata
    пер value: Строка
    пер data: ДанныеDadata;

структура ДанныеDadata
    пер kpp: Строка
    пер ogrn: Строка
    пер name: ИмяDadata
    пер address: АдресDadata
    пер state: СостояниеDadata;

структура ИмяDadata
    пер full_with_opf: Строка
    пер short_with_opf: Строка;

структура АдресDadata
    пер value: Строка;

структура СостояниеDadata
    пер status: Строка;

@Обработчик
метод ЗаполнитьПоИНН(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если Объект.ИНН == ""
        возврат
    ;

    знч Ответ = КлиентHttp
        .ЗапросPost("https://suggestions.dadata.ru/suggestions/api/4_1/rs/findById/party")
        .УстановитьЗаголовок("Authorization", "Token " + ТокенDadata())
        .УстановитьЗаголовок("Accept", "application/json")
        .УстановитьТипСодержимого("application/json")
        .УстановитьТело("{""query"": """ + Объект.ИНН + """}")
        .Выполнить()

    если Ответ.КодСтатуса != 200
        возврат
    ;

    знч Результат = СериализацияJson.ПрочитатьОбъект(Ответ.Тело, Тип<ОтветDadata>)
    если Результат.suggestions.Количество == 0
        возврат
    ;

    знч Данные = Результат.suggestions.Получить(0).data
    Объект.ПолноеНаименование = Данные.name.full_with_opf
    Объект.КПП = Данные.kpp
    Объект.ОГРН = Данные.ogrn
    Объект.ЮридическийАдрес = Данные.address.value
    Объект.СтатусКонтрагента = Данные.state.status
;
