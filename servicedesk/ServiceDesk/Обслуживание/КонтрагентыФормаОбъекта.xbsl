// Заполнение реквизитов контрагента по ИНН через Dadata.
// Ключ API: https://dadata.ru/profile/#info

@НаСервере
структура ОтветDadata
    пер suggestions: Массив<ПодсказкаDadata>;

@НаСервере
структура ПодсказкаDadata
    пер data: ДанныеDadata;

@НаСервере
структура ДанныеDadata
    пер kpp: Строка?
    пер ogrn: Строка?
    пер name: ИмяDadata?
    пер address: АдресDadata?
    пер state: СостояниеDadata?
    пер management: РуководствоDadata?
    пер okveds: Массив<ОквэдDadata>?
    пер phones: Массив<КонтактDadata>?
    пер emails: Массив<КонтактDadata>?;

@НаСервере
структура ИмяDadata
    пер full_with_opf: Строка?
    пер short_with_opf: Строка?;

@НаСервере
структура АдресDadata
    пер value: Строка?;

@НаСервере
структура СостояниеDadata
    пер status: Строка?;

@НаСервере
структура РуководствоDadata
    пер name: Строка?
    пер post: Строка?;

@НаСервере
структура ОквэдDadata
    пер main: Булево?
    пер code: Строка?
    пер name: Строка?;

@НаСервере
структура КонтактDadata
    пер value: Строка?;

метод ЗаполнитьПоИНН(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если Объект.ИНН == ""
        возврат
    ;

    знч Данные = ЗапроситьРеквизитыПоИНН(Объект.ИНН)
    если Данные == Неопределено
        возврат
    ;

    Объект.ПолноеНаименование = Данные.Получить(0)
    Объект.КПП = Данные.Получить(1)
    Объект.ОГРН = Данные.Получить(2)
    Объект.ЮридическийАдрес = Данные.Получить(3)
    Объект.СтатусКонтрагента = Данные.Получить(4)

    знч Краткое = Данные.Получить(5)
    Объект.КраткоеНаименование = Краткое
    если Краткое != ""
        Объект.Наименование = Краткое
    ;

    Объект.ОсновнойОКВЭД = Данные.Получить(6)
    Объект.ОсновнойОКВЭДНаименование = Данные.Получить(7)
    Объект.Руководитель = Данные.Получить(8)
    Объект.ДолжностьРуководителя = Данные.Получить(9)

    знч Телефон = Данные.Получить(10)
    если Объект.Телефон == "" и Телефон != ""
        Объект.Телефон = Телефон
    ;

    знч Почта = Данные.Получить(11)
    если Объект.ЭлектроннаяПочта == "" и Почта != ""
        Объект.ЭлектроннаяПочта = Почта
    ;
;

@НаСервере @ДоступноСКлиента
статический метод ЗапроситьРеквизитыПоИНН(ИНН: Строка): Массив<Строка>?
    знч Тело = "{\"query\": \"" + ИНН + "\"}"

    знч Ответ = КлиентHttp
        .ЗапросPost("https://suggestions.dadata.ru/suggestions/api/4_1/rs/findById/party")
        .УстановитьЗаголовок("Authorization", "Token " + ТокенDadata())
        .УстановитьЗаголовок("Accept", "application/json")
        .УстановитьТипСодержимого("application/json")
        .УстановитьТело(Тело)
        .Выполнить()

    если Ответ.КодСтатуса != 200
        возврат Неопределено
    ;

    знч Настройки = новый НастройкиЧтенияОбъектовJson()
    Настройки.ИгнорироватьНеизвестныеСвойства = Истина

    знч Результат = СериализацияJson.ПрочитатьОбъект<ОтветDadata>(Ответ.Тело, Настройки)
    знч Подсказка = Результат.suggestions.ПервыйИлиНеопределено()
    если Подсказка == Неопределено
        возврат Неопределено
    ;

    знч Данные = Подсказка.data
    знч Реквизиты = новый Массив<Строка>()
    Реквизиты.Добавить(Данные.name?.full_with_opf ?? "")
    Реквизиты.Добавить(Данные.kpp ?? "")
    Реквизиты.Добавить(Данные.ogrn ?? "")
    Реквизиты.Добавить(Данные.address?.value ?? "")
    Реквизиты.Добавить(Данные.state?.status ?? "")
    Реквизиты.Добавить(Данные.name?.short_with_opf ?? "")

    // основной ОКВЭД
    пер КодОКВЭД = ""
    пер НаименованиеОКВЭД = ""
    если Данные.okveds != Неопределено
        для Оквэд из Данные.okveds
            если Оквэд.main == Истина
                КодОКВЭД = Оквэд.code ?? ""
                НаименованиеОКВЭД = Оквэд.name ?? ""
            ;
        ;
    ;
    Реквизиты.Добавить(КодОКВЭД)
    Реквизиты.Добавить(НаименованиеОКВЭД)

    Реквизиты.Добавить(Данные.management?.name ?? "")
    Реквизиты.Добавить(Данные.management?.post ?? "")

    пер Телефон = ""
    знч Телефоны = Данные.phones
    если Телефоны != Неопределено
        знч Первый = Телефоны.ПервыйИлиНеопределено()
        если Первый != Неопределено
            Телефон = Первый.value ?? ""
        ;
    ;
    Реквизиты.Добавить(Телефон)

    пер Почта = ""
    знч Адреса = Данные.emails
    если Адреса != Неопределено
        знч ПервыйАдрес = Адреса.ПервыйИлиНеопределено()
        если ПервыйАдрес != Неопределено
            Почта = ПервыйАдрес.value ?? ""
        ;
    ;
    Реквизиты.Добавить(Почта)

    возврат Реквизиты
;

@НаСервере
статический метод ТокенDadata(): Строка
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            ТокенDadata
        ИЗ
            НастройкиСистемы
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат ""
    ;
    возврат Строка.ТокенDadata ?? ""
;

метод Восстановить(Источник: Кнопка, Событие: СобытиеПриНажатии)
    СнятьПометку(Объект.Ссылка)
    этот.Закрыть()
;

@НаСервере @ДоступноСКлиента
статический метод СнятьПометку(Ссылка: Контрагенты.Ссылка?)
    если Ссылка == Неопределено
        возврат
    ;
    Контрагенты.УстановитьПометкуУдаления(Ссылка, Ложь)
;
