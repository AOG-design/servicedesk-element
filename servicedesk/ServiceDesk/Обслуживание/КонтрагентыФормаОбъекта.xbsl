// Заполнение реквизитов контрагента по ИНН через Dadata.
// Ключ API: https://dadata.ru/profile/#info

структура РеквизитыПоИНН
    пер ПолноеНаименование: Строка
    пер КПП: Строка
    пер ОГРН: Строка
    пер ЮридическийАдрес: Строка
    пер Статус: Строка;

структура ОтветDadata
    пер suggestions: Массив<ПодсказкаDadata>;

структура ПодсказкаDadata
    пер data: ДанныеDadata;

структура ДанныеDadata
    пер kpp: Строка
    пер ogrn: Строка
    пер name: ИмяDadata
    пер address: АдресDadata
    пер state: СостояниеDadata;

структура ИмяDadata
    пер full_with_opf: Строка;

структура АдресDadata
    пер value: Строка;

структура СостояниеDadata
    пер status: Строка;

@Обработчик
метод ЗаполнитьПоИНН(Источник: Кнопка, Событие: СобытиеПриНажатии)
    если Объект.ИНН == ""
        возврат
    ;

    знч Данные = ЗапроситьРеквизитыПоИНН(Объект.ИНН)
    если Данные == Неопределено
        возврат
    ;

    Объект.ПолноеНаименование = Данные.ПолноеНаименование
    Объект.КПП = Данные.КПП
    Объект.ОГРН = Данные.ОГРН
    Объект.ЮридическийАдрес = Данные.ЮридическийАдрес
    Объект.СтатусКонтрагента = Данные.Статус
;

@НаСервере @ДоступноСклиента
статический метод ЗапроситьРеквизитыПоИНН(ИНН: Строка): РеквизитыПоИНН?
    знч Тело = "{\"query\": \"" + ИНН + "\"}"

    знч Ответ = КлиентHttp
        .ЗапросPost("https://suggestions.dadata.ru/suggestions/api/4_1/rs/findById/party")
        .УстановитьЗаголовок("Authorization", "Token " + ТокенDadata())
        .УстановитьЗаголовок("Accept", "application/json")
        .УстановитьТипСодержимого("application/json")
        .УстановитьТело(Тело)
        .Выполнить()

    если Ответ.КодСтатуса != 200
        возврат Неопределено
    ;

    знч Результат = СериализацияJson.ПрочитатьОбъект(Ответ.Тело, Тип<ОтветDadata>)
    если Результат.suggestions.Количество == 0
        возврат Неопределено
    ;

    знч Данные = Результат.suggestions.Получить(0).data
    возврат новый РеквизитыПоИНН(
        Данные.name.full_with_opf,
        Данные.kpp,
        Данные.ogrn,
        Данные.address.value,
        Данные.state.status)
;

@НаСервере @ДоступноСклиента
статический метод ТокенDadata(): Строка
    возврат "c7e292e880f938e3f07bb42029d28dfefab82348"
;
