// Обработчики формы списка "Контрагенты": колонки из справочника КолонкиСписков.

@Обработчик
метод ПослеСоздания()
    ОбеспечитьКолонкиСписка()
    ЗагрузитьНастройкуКолонок()
    ПрименитьПорядокКолонок(СобратьПорядок())
;

метод ПрименитьНастройки(Источник: Кнопка, Событие: СобытиеПриНажатии)
    НормализоватьПорядок()
    ЗагрузитьНастройкуКолонок()
    ПрименитьПорядокКолонок(СобратьПорядок())
;

метод ПереместитьВверх(Источник: Кнопка, Событие: СобытиеПриНажатии, ДанныеСтроки: СтрокаДинамическогоСписка<КонтрагентыФормаСписка.СтрокиКолонок>)
    СдвинутьКолонку(ДанныеСтроки.Данные.Ссылка, -1)
    Компоненты.ТаблицаКолонок.Обновить()
    ЗагрузитьНастройкуКолонок()
    ПрименитьПорядокКолонок(СобратьПорядок())
;

метод ПереместитьВниз(Источник: Кнопка, Событие: СобытиеПриНажатии, ДанныеСтроки: СтрокаДинамическогоСписка<КонтрагентыФормаСписка.СтрокиКолонок>)
    СдвинутьКолонку(ДанныеСтроки.Данные.Ссылка, 1)
    Компоненты.ТаблицаКолонок.Обновить()
    ЗагрузитьНастройкуКолонок()
    ПрименитьПорядокКолонок(СобратьПорядок())
;

// ---------------------- порядок ----------------------

метод СобратьПорядок(): Массив<Число>
    знч Итог = новый Массив<Число>()
    пер Шаг = 1
    пока Шаг <= 14
        если ПозНаименование == Шаг и не Итог.Содержит(0)
            Итог.Добавить(0)
        ;
        если ПозИНН == Шаг и не Итог.Содержит(1)
            Итог.Добавить(1)
        ;
        если ПозКраткоеНаименование == Шаг и не Итог.Содержит(2)
            Итог.Добавить(2)
        ;
        если ПозТелефон == Шаг и не Итог.Содержит(3)
            Итог.Добавить(3)
        ;
        если ПозСтатусКонтрагента2 == Шаг и не Итог.Содержит(4)
            Итог.Добавить(4)
        ;
        если ПозРуководитель == Шаг и не Итог.Содержит(5)
            Итог.Добавить(5)
        ;
        если ПозПолноеНаименование == Шаг и не Итог.Содержит(6)
            Итог.Добавить(6)
        ;
        если ПозКПП == Шаг и не Итог.Содержит(7)
            Итог.Добавить(7)
        ;
        если ПозОГРН == Шаг и не Итог.Содержит(8)
            Итог.Добавить(8)
        ;
        если ПозЮридическийАдрес == Шаг и не Итог.Содержит(9)
            Итог.Добавить(9)
        ;
        если ПозЭлектроннаяПочта == Шаг и не Итог.Содержит(10)
            Итог.Добавить(10)
        ;
        если ПозДолжностьРуководителя == Шаг и не Итог.Содержит(11)
            Итог.Добавить(11)
        ;
        если ПозОсновнойОКВЭД == Шаг и не Итог.Содержит(12)
            Итог.Добавить(12)
        ;
        если ПозОсновнойОКВЭДНаименование == Шаг и не Итог.Содержит(13)
            Итог.Добавить(13)
        ;
        Шаг = Шаг + 1
    ;
    если не Итог.Содержит(0)
        Итог.Добавить(0)
    ;
    если не Итог.Содержит(1)
        Итог.Добавить(1)
    ;
    если не Итог.Содержит(2)
        Итог.Добавить(2)
    ;
    если не Итог.Содержит(3)
        Итог.Добавить(3)
    ;
    если не Итог.Содержит(4)
        Итог.Добавить(4)
    ;
    если не Итог.Содержит(5)
        Итог.Добавить(5)
    ;
    если не Итог.Содержит(6)
        Итог.Добавить(6)
    ;
    если не Итог.Содержит(7)
        Итог.Добавить(7)
    ;
    если не Итог.Содержит(8)
        Итог.Добавить(8)
    ;
    если не Итог.Содержит(9)
        Итог.Добавить(9)
    ;
    если не Итог.Содержит(10)
        Итог.Добавить(10)
    ;
    если не Итог.Содержит(11)
        Итог.Добавить(11)
    ;
    если не Итог.Содержит(12)
        Итог.Добавить(12)
    ;
    если не Итог.Содержит(13)
        Итог.Добавить(13)
    ;
    возврат Итог
;

метод ПрименитьПорядокКолонок(Порядок: Массив<Число>)
    знч Итог = новый Массив<КолонкаТаблицы<СтрокаДинамическогоСписка<КонтрагентыФормаСписка.ДанныеСтрокиСписка>>>()
    пер К = 0
    пока К < 14
        пер Индекс = Порядок.Получить(К)
        если Индекс == 0
            Итог.Добавить(Компоненты.КолНаименование)
        ;
        если Индекс == 1
            Итог.Добавить(Компоненты.КолИНН)
        ;
        если Индекс == 2
            Итог.Добавить(Компоненты.КолКраткоеНаименование)
        ;
        если Индекс == 3
            Итог.Добавить(Компоненты.КолТелефон)
        ;
        если Индекс == 4
            Итог.Добавить(Компоненты.КолСтатусКонтрагента2)
        ;
        если Индекс == 5
            Итог.Добавить(Компоненты.КолРуководитель)
        ;
        если Индекс == 6
            Итог.Добавить(Компоненты.КолПолноеНаименование)
        ;
        если Индекс == 7
            Итог.Добавить(Компоненты.КолКПП)
        ;
        если Индекс == 8
            Итог.Добавить(Компоненты.КолОГРН)
        ;
        если Индекс == 9
            Итог.Добавить(Компоненты.КолЮридическийАдрес)
        ;
        если Индекс == 10
            Итог.Добавить(Компоненты.КолЭлектроннаяПочта)
        ;
        если Индекс == 11
            Итог.Добавить(Компоненты.КолДолжностьРуководителя)
        ;
        если Индекс == 12
            Итог.Добавить(Компоненты.КолОсновнойОКВЭД)
        ;
        если Индекс == 13
            Итог.Добавить(Компоненты.КолОсновнойОКВЭДНаименование)
        ;
        К = К + 1
    ;
    Компоненты.ОсновнаяТаблица.Колонки = Итог
;

метод ПозицияВ(Порядок: Массив<Число>, Значение: Число): Число
    возврат Порядок.Найти(Значение)
;

// ---------------------- чтение настроек ----------------------

метод ЗагрузитьНастройкуКолонок()
    знч Видимость = ПрочитатьВидимость()
    если Видимость != Неопределено
        Наименование = (Видимость.Получить(0) как Булево)
        ИНН = (Видимость.Получить(1) как Булево)
        КраткоеНаименование = (Видимость.Получить(2) как Булево)
        Телефон = (Видимость.Получить(3) как Булево)
        СтатусКонтрагента2 = (Видимость.Получить(4) как Булево)
        Руководитель = (Видимость.Получить(5) как Булево)
        ПолноеНаименование = (Видимость.Получить(6) как Булево)
        КПП = (Видимость.Получить(7) как Булево)
        ОГРН = (Видимость.Получить(8) как Булево)
        ЮридическийАдрес = (Видимость.Получить(9) как Булево)
        ЭлектроннаяПочта = (Видимость.Получить(10) как Булево)
        ДолжностьРуководителя = (Видимость.Получить(11) как Булево)
        ОсновнойОКВЭД = (Видимость.Получить(12) как Булево)
        ОсновнойОКВЭДНаименование = (Видимость.Получить(13) как Булево)
    ;

    знч Позиции = ПрочитатьПозиции()
    если Позиции != Неопределено
        ПозНаименование = (Позиции.Получить(0) как Число)
        ПозИНН = (Позиции.Получить(1) как Число)
        ПозКраткоеНаименование = (Позиции.Получить(2) как Число)
        ПозТелефон = (Позиции.Получить(3) как Число)
        ПозСтатусКонтрагента2 = (Позиции.Получить(4) как Число)
        ПозРуководитель = (Позиции.Получить(5) как Число)
        ПозПолноеНаименование = (Позиции.Получить(6) как Число)
        ПозКПП = (Позиции.Получить(7) как Число)
        ПозОГРН = (Позиции.Получить(8) как Число)
        ПозЮридическийАдрес = (Позиции.Получить(9) как Число)
        ПозЭлектроннаяПочта = (Позиции.Получить(10) как Число)
        ПозДолжностьРуководителя = (Позиции.Получить(11) как Число)
        ПозОсновнойОКВЭД = (Позиции.Получить(12) как Число)
        ПозОсновнойОКВЭДНаименование = (Позиции.Получить(13) как Число)
    ;
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьПозиции(): Массив<Число>?
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат Неопределено
    ;

    знч Идентификатор = "Контрагенты"
    знч Запрос = Запрос{
        ВЫБРАТЬ
            КлючКолонки,
            ПорядокКолонки
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
    }

    знч Позиции = новый Массив<Число>()
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)

    для Строка из Запрос.Выполнить()
        если Строка.КлючКолонки == "Наименование"
            Позиции.Установить(0, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ИНН"
            Позиции.Установить(1, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "КраткоеНаименование"
            Позиции.Установить(2, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "Телефон"
            Позиции.Установить(3, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "СтатусКонтрагента"
            Позиции.Установить(4, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "Руководитель"
            Позиции.Установить(5, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ПолноеНаименование"
            Позиции.Установить(6, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "КПП"
            Позиции.Установить(7, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ОГРН"
            Позиции.Установить(8, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ЮридическийАдрес"
            Позиции.Установить(9, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ЭлектроннаяПочта"
            Позиции.Установить(10, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ДолжностьРуководителя"
            Позиции.Установить(11, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ОсновнойОКВЭД"
            Позиции.Установить(12, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ОсновнойОКВЭДНаименование"
            Позиции.Установить(13, Строка.ПорядокКолонки)
        ;
    ;
    возврат Позиции
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьВидимость(): Массив<Булево>?
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат Неопределено
    ;

    знч Идентификатор = "Контрагенты"
    знч Запрос = Запрос{
        ВЫБРАТЬ
            КлючКолонки,
            ВидимостьКолонки
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
    }

    знч Видимость = новый Массив<Булево>()
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)

    для Строка из Запрос.Выполнить()
        если Строка.КлючКолонки == "Наименование"
            Видимость.Установить(0, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ИНН"
            Видимость.Установить(1, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "КраткоеНаименование"
            Видимость.Установить(2, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "Телефон"
            Видимость.Установить(3, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "СтатусКонтрагента"
            Видимость.Установить(4, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "Руководитель"
            Видимость.Установить(5, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ПолноеНаименование"
            Видимость.Установить(6, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "КПП"
            Видимость.Установить(7, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ОГРН"
            Видимость.Установить(8, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ЮридическийАдрес"
            Видимость.Установить(9, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ЭлектроннаяПочта"
            Видимость.Установить(10, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ДолжностьРуководителя"
            Видимость.Установить(11, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ОсновнойОКВЭД"
            Видимость.Установить(12, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ОсновнойОКВЭДНаименование"
            Видимость.Установить(13, Строка.ВидимостьКолонки)
        ;
    ;
    возврат Видимость
;

// ---------------------- справочник колонок ----------------------

@НаСервере @ДоступноСКлиента
статический метод ОбеспечитьКолонкиСписка()
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;
    если ЕстьКолонкиСписка(Профиль)
        возврат
    ;
    СоздатьКолонку(Профиль, "Наименование", "Наименование", 1, Истина)
    СоздатьКолонку(Профиль, "ИНН", "ИНН", 2, Истина)
    СоздатьКолонку(Профиль, "КраткоеНаименование", "КраткоеНаименование", 3, Истина)
    СоздатьКолонку(Профиль, "Телефон", "Телефон", 4, Истина)
    СоздатьКолонку(Профиль, "СтатусКонтрагента", "СтатусКонтрагента", 5, Истина)
    СоздатьКолонку(Профиль, "Руководитель", "Руководитель", 6, Истина)
    СоздатьКолонку(Профиль, "ПолноеНаименование", "ПолноеНаименование", 7, Ложь)
    СоздатьКолонку(Профиль, "КПП", "КПП", 8, Ложь)
    СоздатьКолонку(Профиль, "ОГРН", "ОГРН", 9, Ложь)
    СоздатьКолонку(Профиль, "ЮридическийАдрес", "ЮридическийАдрес", 10, Ложь)
    СоздатьКолонку(Профиль, "ЭлектроннаяПочта", "ЭлектроннаяПочта", 11, Ложь)
    СоздатьКолонку(Профиль, "ДолжностьРуководителя", "ДолжностьРуководителя", 12, Ложь)
    СоздатьКолонку(Профиль, "ОсновнойОКВЭД", "ОсновнойОКВЭД", 13, Ложь)
    СоздатьКолонку(Профиль, "ОсновнойОКВЭДНаименование", "ОсновнойОКВЭДНаименование", 14, Ложь)
;

@НаСервере @ДоступноСКлиента
статический метод ЕстьКолонкиСписка(Профиль: ПользователиПриложения.Ссылка?): Булево
    знч Идентификатор = "Контрагенты"
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено() != Неопределено
;

@НаСервере
статический метод СоздатьКолонку(Профиль: ПользователиПриложения.Ссылка?, Заголовок: Строка, Ключ: Строка, Порядок: Число, Видимость: Булево)
    знч Идентификатор = "Контрагенты"
    знч Объект = новый КолонкиСписков.Объект()
    Объект.Наименование = Заголовок
    Объект.Пользователь = Профиль
    Объект.ИдентификаторСписка = Идентификатор
    Объект.КлючКолонки = Ключ
    Объект.ЗаголовокКолонки = Заголовок
    Объект.ПорядокКолонки = Порядок
    Объект.ВидимостьКолонки = Видимость
    Объект.Записать()
;

@НаСервере @ДоступноСКлиента
статический метод НормализоватьПорядок()
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;

    знч Идентификатор = "Контрагенты"
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
        УПОРЯДОЧИТЬ ПО
            ПорядокКолонки,
            ЗаголовокКолонки
    }

    пер Номер = 1
    для Строка из Запрос.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект()
        если Объект != Неопределено
            Объект.ПорядокКолонки = Номер
            Объект.Записать()
            Номер = Номер + 1
        ;
    ;
;

@НаСервере @ДоступноСКлиента
статический метод СдвинутьКолонку(Ссылка: КолонкиСписков.Ссылка?, Сдвиг: Число)
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено или Ссылка == Неопределено
        возврат
    ;

    знч Идентификатор = "Контрагенты"
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
        УПОРЯДОЧИТЬ ПО
            ПорядокКолонки,
            ЗаголовокКолонки
    }

    знч Порядок = новый Массив<КолонкиСписков.Ссылка>()
    для Строка из Запрос.Выполнить()
        Порядок.Добавить(Строка.Ссылка)
    ;

    пер Позиция = Порядок.Найти(Ссылка)
    если Позиция < 0
        возврат
    ;
    пер Новая = Позиция + Сдвиг
    если Новая < 0 или Новая >= 14
        возврат
    ;

    знч Текущая = Порядок.Получить(Позиция)
    знч Соседняя = Порядок.Получить(Новая)
    Порядок.Установить(Позиция, Соседняя)
    Порядок.Установить(Новая, Текущая)

    пер Номер = 1
    для Элемент из Порядок
        знч Объект = Элемент.ЗагрузитьОбъект()
        если Объект != Неопределено
            Объект.ПорядокКолонки = Номер
            Объект.Записать()
            Номер = Номер + 1
        ;
    ;
;

@НаСервере
статический метод ТекущийПрофиль(): ПользователиПриложения.Ссылка?
    знч УчетнаяЗапись = Пользователи.ТекущийПользователь
    если УчетнаяЗапись == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            ПользователиПриложения
        ГДЕ
            УчетнаяЗапись == %УчетнаяЗапись
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено()?.Ссылка
;
