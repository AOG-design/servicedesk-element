// Обработчики формы списка "Обращения": видимость и порядок колонок.

@Обработчик
метод ПослеСоздания()
    ЗагрузитьНастройкуКолонок()
    ПрименитьПорядокКолонок()
;

метод ЗагрузитьНастройкуКолонок()
    знч Видимость = ПрочитатьВидимость()
    если Видимость != Неопределено
        Дата = (Видимость.Получить(0) как Булево)
        Номер = (Видимость.Получить(1) как Булево)
        Контрагент = (Видимость.Получить(2) как Булево)
        Направление = (Видимость.Получить(3) как Булево)
        Срочность = (Видимость.Получить(4) как Булево)
        Статус = (Видимость.Получить(5) как Булево)
        Исполнитель = (Видимость.Получить(6) как Булево)
        КонтактноеЛицо = (Видимость.Получить(7) как Булево)
        Телефон = (Видимость.Получить(8) как Булево)
        МобильныйТелефон = (Видимость.Получить(9) как Булево)
        КодГорода = (Видимость.Получить(10) как Булево)
        Добавочный = (Видимость.Получить(11) как Булево)
        НомерВходящий = (Видимость.Получить(12) как Булево)
        ОбслОрганизация = (Видимость.Получить(13) как Булево)
        ПользовательОбращения = (Видимость.Получить(14) как Булево)
        НовыйКонтрагент = (Видимость.Получить(15) как Булево)
        Уведомление = (Видимость.Получить(16) как Булево)
        НаправлениеЗаказчика = (Видимость.Получить(17) как Булево)
        ОписаниеЗаказчика = (Видимость.Получить(18) как Булево)
        СрочностьЗаказчика = (Видимость.Получить(19) как Булево)
        ОписаниеИсполнителя = (Видимость.Получить(20) как Булево)
        ПредпочтДата = (Видимость.Получить(21) как Булево)
        ПредпочтВремя = (Видимость.Получить(22) как Булево)
        ПредпочтСотрудник = (Видимость.Получить(23) как Булево)
    ;

    знч Позиции = ПрочитатьПозиции()
    если Позиции != Неопределено
        ПозДата = (Позиции.Получить(0) как Число)
        ПозНомер = (Позиции.Получить(1) как Число)
        ПозКонтрагент = (Позиции.Получить(2) как Число)
        ПозНаправление = (Позиции.Получить(3) как Число)
        ПозСрочность = (Позиции.Получить(4) как Число)
        ПозСтатус = (Позиции.Получить(5) как Число)
        ПозИсполнитель = (Позиции.Получить(6) как Число)
        ПозКонтактноеЛицо = (Позиции.Получить(7) как Число)
        ПозТелефон = (Позиции.Получить(8) как Число)
        ПозМобильныйТелефон = (Позиции.Получить(9) как Число)
        ПозКодГорода = (Позиции.Получить(10) как Число)
        ПозДобавочный = (Позиции.Получить(11) как Число)
        ПозНомерВходящий = (Позиции.Получить(12) как Число)
        ПозОбслОрганизация = (Позиции.Получить(13) как Число)
        ПозПользовательОбращения = (Позиции.Получить(14) как Число)
        ПозНовыйКонтрагент = (Позиции.Получить(15) как Число)
        ПозУведомление = (Позиции.Получить(16) как Число)
        ПозНаправлениеЗаказчика = (Позиции.Получить(17) как Число)
        ПозОписаниеЗаказчика = (Позиции.Получить(18) как Число)
        ПозСрочностьЗаказчика = (Позиции.Получить(19) как Число)
        ПозОписаниеИсполнителя = (Позиции.Получить(20) как Число)
        ПозПредпочтДата = (Позиции.Получить(21) как Число)
        ПозПредпочтВремя = (Позиции.Получить(22) как Число)
        ПозПредпочтСотрудник = (Позиции.Получить(23) как Число)
    ;
;

метод ПрименитьПорядокКолонок()
    знч Все = Компоненты.ОсновнаяТаблица.Колонки
    знч Итог = новый Массив<КолонкаТаблицы<СтрокаДинамическогоСписка<ОбращенияФормаСписка.ДанныеСтрокиСписка>>>()
    пер Индексы = новый Массив<Число>()

    пер Шаг = 1
    пока Шаг <= 24
        если ПозДата == Шаг и не СодержитИндекс(Индексы, 0)
            Итог.Добавить(Все.Получить(0))
            Индексы.Добавить(0)
        ;
        если ПозНомер == Шаг и не СодержитИндекс(Индексы, 1)
            Итог.Добавить(Все.Получить(1))
            Индексы.Добавить(1)
        ;
        если ПозКонтрагент == Шаг и не СодержитИндекс(Индексы, 2)
            Итог.Добавить(Все.Получить(2))
            Индексы.Добавить(2)
        ;
        если ПозНаправление == Шаг и не СодержитИндекс(Индексы, 3)
            Итог.Добавить(Все.Получить(3))
            Индексы.Добавить(3)
        ;
        если ПозСрочность == Шаг и не СодержитИндекс(Индексы, 4)
            Итог.Добавить(Все.Получить(4))
            Индексы.Добавить(4)
        ;
        если ПозСтатус == Шаг и не СодержитИндекс(Индексы, 5)
            Итог.Добавить(Все.Получить(5))
            Индексы.Добавить(5)
        ;
        если ПозИсполнитель == Шаг и не СодержитИндекс(Индексы, 6)
            Итог.Добавить(Все.Получить(6))
            Индексы.Добавить(6)
        ;
        если ПозКонтактноеЛицо == Шаг и не СодержитИндекс(Индексы, 7)
            Итог.Добавить(Все.Получить(7))
            Индексы.Добавить(7)
        ;
        если ПозТелефон == Шаг и не СодержитИндекс(Индексы, 8)
            Итог.Добавить(Все.Получить(8))
            Индексы.Добавить(8)
        ;
        если ПозМобильныйТелефон == Шаг и не СодержитИндекс(Индексы, 9)
            Итог.Добавить(Все.Получить(9))
            Индексы.Добавить(9)
        ;
        если ПозКодГорода == Шаг и не СодержитИндекс(Индексы, 10)
            Итог.Добавить(Все.Получить(10))
            Индексы.Добавить(10)
        ;
        если ПозДобавочный == Шаг и не СодержитИндекс(Индексы, 11)
            Итог.Добавить(Все.Получить(11))
            Индексы.Добавить(11)
        ;
        если ПозНомерВходящий == Шаг и не СодержитИндекс(Индексы, 12)
            Итог.Добавить(Все.Получить(12))
            Индексы.Добавить(12)
        ;
        если ПозОбслОрганизация == Шаг и не СодержитИндекс(Индексы, 13)
            Итог.Добавить(Все.Получить(13))
            Индексы.Добавить(13)
        ;
        если ПозПользовательОбращения == Шаг и не СодержитИндекс(Индексы, 14)
            Итог.Добавить(Все.Получить(14))
            Индексы.Добавить(14)
        ;
        если ПозНовыйКонтрагент == Шаг и не СодержитИндекс(Индексы, 15)
            Итог.Добавить(Все.Получить(15))
            Индексы.Добавить(15)
        ;
        если ПозУведомление == Шаг и не СодержитИндекс(Индексы, 16)
            Итог.Добавить(Все.Получить(16))
            Индексы.Добавить(16)
        ;
        если ПозНаправлениеЗаказчика == Шаг и не СодержитИндекс(Индексы, 17)
            Итог.Добавить(Все.Получить(17))
            Индексы.Добавить(17)
        ;
        если ПозОписаниеЗаказчика == Шаг и не СодержитИндекс(Индексы, 18)
            Итог.Добавить(Все.Получить(18))
            Индексы.Добавить(18)
        ;
        если ПозСрочностьЗаказчика == Шаг и не СодержитИндекс(Индексы, 19)
            Итог.Добавить(Все.Получить(19))
            Индексы.Добавить(19)
        ;
        если ПозОписаниеИсполнителя == Шаг и не СодержитИндекс(Индексы, 20)
            Итог.Добавить(Все.Получить(20))
            Индексы.Добавить(20)
        ;
        если ПозПредпочтДата == Шаг и не СодержитИндекс(Индексы, 21)
            Итог.Добавить(Все.Получить(21))
            Индексы.Добавить(21)
        ;
        если ПозПредпочтВремя == Шаг и не СодержитИндекс(Индексы, 22)
            Итог.Добавить(Все.Получить(22))
            Индексы.Добавить(22)
        ;
        если ПозПредпочтСотрудник == Шаг и не СодержитИндекс(Индексы, 23)
            Итог.Добавить(Все.Получить(23))
            Индексы.Добавить(23)
        ;
        Шаг = Шаг + 1
    ;

    если не СодержитИндекс(Индексы, 0)
        Итог.Добавить(Все.Получить(0))
        Индексы.Добавить(0)
    ;
    если не СодержитИндекс(Индексы, 1)
        Итог.Добавить(Все.Получить(1))
        Индексы.Добавить(1)
    ;
    если не СодержитИндекс(Индексы, 2)
        Итог.Добавить(Все.Получить(2))
        Индексы.Добавить(2)
    ;
    если не СодержитИндекс(Индексы, 3)
        Итог.Добавить(Все.Получить(3))
        Индексы.Добавить(3)
    ;
    если не СодержитИндекс(Индексы, 4)
        Итог.Добавить(Все.Получить(4))
        Индексы.Добавить(4)
    ;
    если не СодержитИндекс(Индексы, 5)
        Итог.Добавить(Все.Получить(5))
        Индексы.Добавить(5)
    ;
    если не СодержитИндекс(Индексы, 6)
        Итог.Добавить(Все.Получить(6))
        Индексы.Добавить(6)
    ;
    если не СодержитИндекс(Индексы, 7)
        Итог.Добавить(Все.Получить(7))
        Индексы.Добавить(7)
    ;
    если не СодержитИндекс(Индексы, 8)
        Итог.Добавить(Все.Получить(8))
        Индексы.Добавить(8)
    ;
    если не СодержитИндекс(Индексы, 9)
        Итог.Добавить(Все.Получить(9))
        Индексы.Добавить(9)
    ;
    если не СодержитИндекс(Индексы, 10)
        Итог.Добавить(Все.Получить(10))
        Индексы.Добавить(10)
    ;
    если не СодержитИндекс(Индексы, 11)
        Итог.Добавить(Все.Получить(11))
        Индексы.Добавить(11)
    ;
    если не СодержитИндекс(Индексы, 12)
        Итог.Добавить(Все.Получить(12))
        Индексы.Добавить(12)
    ;
    если не СодержитИндекс(Индексы, 13)
        Итог.Добавить(Все.Получить(13))
        Индексы.Добавить(13)
    ;
    если не СодержитИндекс(Индексы, 14)
        Итог.Добавить(Все.Получить(14))
        Индексы.Добавить(14)
    ;
    если не СодержитИндекс(Индексы, 15)
        Итог.Добавить(Все.Получить(15))
        Индексы.Добавить(15)
    ;
    если не СодержитИндекс(Индексы, 16)
        Итог.Добавить(Все.Получить(16))
        Индексы.Добавить(16)
    ;
    если не СодержитИндекс(Индексы, 17)
        Итог.Добавить(Все.Получить(17))
        Индексы.Добавить(17)
    ;
    если не СодержитИндекс(Индексы, 18)
        Итог.Добавить(Все.Получить(18))
        Индексы.Добавить(18)
    ;
    если не СодержитИндекс(Индексы, 19)
        Итог.Добавить(Все.Получить(19))
        Индексы.Добавить(19)
    ;
    если не СодержитИндекс(Индексы, 20)
        Итог.Добавить(Все.Получить(20))
        Индексы.Добавить(20)
    ;
    если не СодержитИндекс(Индексы, 21)
        Итог.Добавить(Все.Получить(21))
        Индексы.Добавить(21)
    ;
    если не СодержитИндекс(Индексы, 22)
        Итог.Добавить(Все.Получить(22))
        Индексы.Добавить(22)
    ;
    если не СодержитИндекс(Индексы, 23)
        Итог.Добавить(Все.Получить(23))
        Индексы.Добавить(23)
    ;

    Компоненты.ОсновнаяТаблица.Колонки = Итог
;

метод СодержитИндекс(Индексы: Массив<Число>, Значение: Число): Булево
    для Индекс из Индексы
        если Индекс == Значение
            возврат Истина
        ;
    ;
    возврат Ложь
;

метод СохранитьНастройкуКолонок(Источник: Кнопка, Событие: СобытиеПриНажатии)
    знч Видимость = новый Массив<Булево>()
    Видимость.Добавить(Дата)
    Видимость.Добавить(Номер)
    Видимость.Добавить(Контрагент)
    Видимость.Добавить(Направление)
    Видимость.Добавить(Срочность)
    Видимость.Добавить(Статус)
    Видимость.Добавить(Исполнитель)
    Видимость.Добавить(КонтактноеЛицо)
    Видимость.Добавить(Телефон)
    Видимость.Добавить(МобильныйТелефон)
    Видимость.Добавить(КодГорода)
    Видимость.Добавить(Добавочный)
    Видимость.Добавить(НомерВходящий)
    Видимость.Добавить(ОбслОрганизация)
    Видимость.Добавить(ПользовательОбращения)
    Видимость.Добавить(НовыйКонтрагент)
    Видимость.Добавить(Уведомление)
    Видимость.Добавить(НаправлениеЗаказчика)
    Видимость.Добавить(ОписаниеЗаказчика)
    Видимость.Добавить(СрочностьЗаказчика)
    Видимость.Добавить(ОписаниеИсполнителя)
    Видимость.Добавить(ПредпочтДата)
    Видимость.Добавить(ПредпочтВремя)
    Видимость.Добавить(ПредпочтСотрудник)

    знч Позиции = новый Массив<Число>()
    Позиции.Добавить(ПозДата)
    Позиции.Добавить(ПозНомер)
    Позиции.Добавить(ПозКонтрагент)
    Позиции.Добавить(ПозНаправление)
    Позиции.Добавить(ПозСрочность)
    Позиции.Добавить(ПозСтатус)
    Позиции.Добавить(ПозИсполнитель)
    Позиции.Добавить(ПозКонтактноеЛицо)
    Позиции.Добавить(ПозТелефон)
    Позиции.Добавить(ПозМобильныйТелефон)
    Позиции.Добавить(ПозКодГорода)
    Позиции.Добавить(ПозДобавочный)
    Позиции.Добавить(ПозНомерВходящий)
    Позиции.Добавить(ПозОбслОрганизация)
    Позиции.Добавить(ПозПользовательОбращения)
    Позиции.Добавить(ПозНовыйКонтрагент)
    Позиции.Добавить(ПозУведомление)
    Позиции.Добавить(ПозНаправлениеЗаказчика)
    Позиции.Добавить(ПозОписаниеЗаказчика)
    Позиции.Добавить(ПозСрочностьЗаказчика)
    Позиции.Добавить(ПозОписаниеИсполнителя)
    Позиции.Добавить(ПозПредпочтДата)
    Позиции.Добавить(ПозПредпочтВремя)
    Позиции.Добавить(ПозПредпочтСотрудник)

    ЗаписатьНастройку(Видимость, Позиции)
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьВидимость(): Массив<Булево>?
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Дата,
            Номер,
            Контрагент,
            Направление,
            Срочность,
            Статус,
            Исполнитель,
            КонтактноеЛицо,
            Телефон,
            МобильныйТелефон,
            КодГорода,
            Добавочный,
            НомерВходящий,
            ОбслОрганизация,
            ПользовательОбращения,
            НовыйКонтрагент,
            Уведомление,
            НаправлениеЗаказчика,
            ОписаниеЗаказчика,
            СрочностьЗаказчика,
            ОписаниеИсполнителя,
            ПредпочтДата,
            ПредпочтВремя,
            ПредпочтСотрудник
        ИЗ
            НастройкиКолонокОбращений
        ГДЕ
            Пользователь == %Профиль
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат Неопределено
    ;

    знч Результат = новый Массив<Булево>()
    Результат.Добавить(Строка.Дата)
    Результат.Добавить(Строка.Номер)
    Результат.Добавить(Строка.Контрагент)
    Результат.Добавить(Строка.Направление)
    Результат.Добавить(Строка.Срочность)
    Результат.Добавить(Строка.Статус)
    Результат.Добавить(Строка.Исполнитель)
    Результат.Добавить(Строка.КонтактноеЛицо)
    Результат.Добавить(Строка.Телефон)
    Результат.Добавить(Строка.МобильныйТелефон)
    Результат.Добавить(Строка.КодГорода)
    Результат.Добавить(Строка.Добавочный)
    Результат.Добавить(Строка.НомерВходящий)
    Результат.Добавить(Строка.ОбслОрганизация)
    Результат.Добавить(Строка.ПользовательОбращения)
    Результат.Добавить(Строка.НовыйКонтрагент)
    Результат.Добавить(Строка.Уведомление)
    Результат.Добавить(Строка.НаправлениеЗаказчика)
    Результат.Добавить(Строка.ОписаниеЗаказчика)
    Результат.Добавить(Строка.СрочностьЗаказчика)
    Результат.Добавить(Строка.ОписаниеИсполнителя)
    Результат.Добавить(Строка.ПредпочтДата)
    Результат.Добавить(Строка.ПредпочтВремя)
    Результат.Добавить(Строка.ПредпочтСотрудник)
    возврат Результат
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьПозиции(): Массив<Число>?
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            ПозДата,
            ПозНомер,
            ПозКонтрагент,
            ПозНаправление,
            ПозСрочность,
            ПозСтатус,
            ПозИсполнитель,
            ПозКонтактноеЛицо,
            ПозТелефон,
            ПозМобильныйТелефон,
            ПозКодГорода,
            ПозДобавочный,
            ПозНомерВходящий,
            ПозОбслОрганизация,
            ПозПользовательОбращения,
            ПозНовыйКонтрагент,
            ПозУведомление,
            ПозНаправлениеЗаказчика,
            ПозОписаниеЗаказчика,
            ПозСрочностьЗаказчика,
            ПозОписаниеИсполнителя,
            ПозПредпочтДата,
            ПозПредпочтВремя,
            ПозПредпочтСотрудник
        ИЗ
            НастройкиКолонокОбращений
        ГДЕ
            Пользователь == %Профиль
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат Неопределено
    ;

    знч Результат = новый Массив<Число>()
    Результат.Добавить(Строка.ПозДата)
    Результат.Добавить(Строка.ПозНомер)
    Результат.Добавить(Строка.ПозКонтрагент)
    Результат.Добавить(Строка.ПозНаправление)
    Результат.Добавить(Строка.ПозСрочность)
    Результат.Добавить(Строка.ПозСтатус)
    Результат.Добавить(Строка.ПозИсполнитель)
    Результат.Добавить(Строка.ПозКонтактноеЛицо)
    Результат.Добавить(Строка.ПозТелефон)
    Результат.Добавить(Строка.ПозМобильныйТелефон)
    Результат.Добавить(Строка.ПозКодГорода)
    Результат.Добавить(Строка.ПозДобавочный)
    Результат.Добавить(Строка.ПозНомерВходящий)
    Результат.Добавить(Строка.ПозОбслОрганизация)
    Результат.Добавить(Строка.ПозПользовательОбращения)
    Результат.Добавить(Строка.ПозНовыйКонтрагент)
    Результат.Добавить(Строка.ПозУведомление)
    Результат.Добавить(Строка.ПозНаправлениеЗаказчика)
    Результат.Добавить(Строка.ПозОписаниеЗаказчика)
    Результат.Добавить(Строка.ПозСрочностьЗаказчика)
    Результат.Добавить(Строка.ПозОписаниеИсполнителя)
    Результат.Добавить(Строка.ПозПредпочтДата)
    Результат.Добавить(Строка.ПозПредпочтВремя)
    Результат.Добавить(Строка.ПозПредпочтСотрудник)
    возврат Результат
;

@НаСервере @ДоступноСКлиента
статический метод ЗаписатьНастройку(Видимость: Массив<Булево>, Позиции: Массив<Число>)
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;

    знч Существующая = НастройкаПоПрофилю(Профиль)
    если Существующая == Неопределено
        знч Новая = новый НастройкиКолонокОбращений.Объект()
        Новая.Наименование = "Настройки колонок: " + Профиль.Представление()
        Новая.Пользователь = Профиль
        Заполнить(Новая, Видимость, Позиции)
        Новая.Записать()
        возврат
    ;

    знч ОбъектНастройки = Существующая.ЗагрузитьОбъект()
    если ОбъектНастройки == Неопределено
        возврат
    ;
    Заполнить(ОбъектНастройки, Видимость, Позиции)
    ОбъектНастройки.Записать()
;

@НаСервере
статический метод Заполнить(Настройка: НастройкиКолонокОбращений.Объект, Видимость: Массив<Булево>, Позиции: Массив<Число>)
    Настройка.Дата = Видимость.Получить(0) как Булево
    Настройка.Номер = Видимость.Получить(1) как Булево
    Настройка.Контрагент = Видимость.Получить(2) как Булево
    Настройка.Направление = Видимость.Получить(3) как Булево
