@НаСервере @ДоступноСКлиента
статический метод ЗаписатьНастройку(Видимость: Массив<Булево>, Позиции: Массив<Число>)
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;
        СохранитьКолонку(Профиль, "Дата", Позиции.Получить(0), Видимость.Получить(0))
        СохранитьКолонку(Профиль, "Номер", Позиции.Получить(1), Видимость.Получить(1))
        СохранитьКолонку(Профиль, "Контрагент", Позиции.Получить(2), Видимость.Получить(2))
        СохранитьКолонку(Профиль, "НаправлениеРаботыКлассифицированное", Позиции.Получить(3), Видимость.Получить(3))
        СохранитьКолонку(Профиль, "СрочностьКлассифицированная", Позиции.Получить(4), Видимость.Получить(4))
        СохранитьКолонку(Профиль, "Статус", Позиции.Получить(5), Видимость.Получить(5))
        СохранитьКолонку(Профиль, "Исполнитель", Позиции.Получить(6), Видимость.Получить(6))
        СохранитьКолонку(Профиль, "КонтактноеЛицо", Позиции.Получить(7), Видимость.Получить(7))
        СохранитьКолонку(Профиль, "ТелефонКонтактногоЛица", Позиции.Получить(8), Видимость.Получить(8))
        СохранитьКолонку(Профиль, "МобильныйТелефонКонтактногоЛица", Позиции.Получить(9), Видимость.Получить(9))
        СохранитьКолонку(Профиль, "КодГорода", Позиции.Получить(10), Видимость.Получить(10))
        СохранитьКолонку(Профиль, "ДобавочныйНомер", Позиции.Получить(11), Видимость.Получить(11))
        СохранитьКолонку(Профиль, "НомерОбращенияВходящий", Позиции.Получить(12), Видимость.Получить(12))
        СохранитьКолонку(Профиль, "ОбслуживаемаяОрганизация", Позиции.Получить(13), Видимость.Получить(13))
        СохранитьКолонку(Профиль, "Пользователь", Позиции.Получить(14), Видимость.Получить(14))
        СохранитьКолонку(Профиль, "ПризнакНовогоКонтрагента", Позиции.Получить(15), Видимость.Получить(15))
        СохранитьКолонку(Профиль, "УведомлениеОтправлено", Позиции.Получить(16), Видимость.Получить(16))
        СохранитьКолонку(Профиль, "НаправлениеРаботыСоСловЗаказчика", Позиции.Получить(17), Видимость.Получить(17))
        СохранитьКолонку(Профиль, "ОписаниеПроблемыСоСловЗаказчика", Позиции.Получить(18), Видимость.Получить(18))
        СохранитьКолонку(Профиль, "СрочностьСоСловЗаказчика", Позиции.Получить(19), Видимость.Получить(19))
        СохранитьКолонку(Профиль, "ОписаниеПроблемыКлассифицированное", Позиции.Получить(20), Видимость.Получить(20))
        СохранитьКолонку(Профиль, "ПредпочтительнаяДатаНачала", Позиции.Получить(21), Видимость.Получить(21))
        СохранитьКолонку(Профиль, "ПредпочтительноеВремяРаботы", Позиции.Получить(22), Видимость.Получить(22))
        СохранитьКолонку(Профиль, "ПредпочтительныйСотрудник", Позиции.Получить(23), Видимость.Получить(23))
;

@НаСервере
статический метод СохранитьКолонку(Профиль: ПользователиПриложения.Ссылка?, Ключ: Строка, Порядок: Число, Видимость: Булево)
    знч Идентификатор = "Обращения"
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
            И КлючКолонки == %Ключ
    }
    знч Ссылка = Запрос.Выполнить().ПервыйИлиНеопределено()?.Ссылка
    если Ссылка == Неопределено
        возврат
    ;
    знч Объект = Ссылка.ЗагрузитьОбъект()
    если Объект == Неопределено
        возврат
    ;
    Объект.ПорядокКолонки = Порядок
    Объект.ВидимостьКолонки = Видимость
    Объект.Записать()
;

// ---------------------- справочник колонок списка ----------------------

@НаСервере @ДоступноСКлиента
статический метод ОбеспечитьКолонкиСписка()
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;
    если ЕстьКолонкиСписка(Профиль)
        возврат
    ;
    СоздатьКолонку(Профиль, "Дата", "Дата", 1, Истина)
    СоздатьКолонку(Профиль, "Номер", "Номер", 2, Истина)
    СоздатьКолонку(Профиль, "Контрагент", "Контрагент", 3, Истина)
    СоздатьКолонку(Профиль, "Направление", "НаправлениеРаботыКлассифицированное", 4, Истина)
    СоздатьКолонку(Профиль, "Срочность", "СрочностьКлассифицированная", 5, Истина)
    СоздатьКолонку(Профиль, "Статус", "Статус", 6, Истина)
    СоздатьКолонку(Профиль, "Исполнитель", "Исполнитель", 7, Истина)
    СоздатьКолонку(Профиль, "Контактное лицо", "КонтактноеЛицо", 8, Ложь)
    СоздатьКолонку(Профиль, "Телефон", "ТелефонКонтактногоЛица", 9, Ложь)
    СоздатьКолонку(Профиль, "Мобильный телефон", "МобильныйТелефонКонтактногоЛица", 10, Ложь)
    СоздатьКолонку(Профиль, "Код города", "КодГорода", 11, Ложь)
    СоздатьКолонку(Профиль, "Добавочный", "ДобавочныйНомер", 12, Ложь)
    СоздатьКолонку(Профиль, "Номер входящий", "НомерОбращенияВходящий", 13, Ложь)
    СоздатьКолонку(Профиль, "Обслуживаемая организация", "ОбслуживаемаяОрганизация", 14, Ложь)
    СоздатьКолонку(Профиль, "Пользователь", "Пользователь", 15, Ложь)
    СоздатьКолонку(Профиль, "Новый контрагент", "ПризнакНовогоКонтрагента", 16, Ложь)
    СоздатьКолонку(Профиль, "Уведомление отправлено", "УведомлениеОтправлено", 17, Ложь)
    СоздатьКолонку(Профиль, "Направление (заказчик)", "НаправлениеРаботыСоСловЗаказчика", 18, Ложь)
    СоздатьКолонку(Профиль, "Описание (заказчик)", "ОписаниеПроблемыСоСловЗаказчика", 19, Ложь)
    СоздатьКолонку(Профиль, "Срочность (заказчик)", "СрочностьСоСловЗаказчика", 20, Ложь)
    СоздатьКолонку(Профиль, "Описание (исполнитель)", "ОписаниеПроблемыКлассифицированное", 21, Ложь)
    СоздатьКолонку(Профиль, "Предпочтительная дата", "ПредпочтительнаяДатаНачала", 22, Ложь)
    СоздатьКолонку(Профиль, "Предпочтительное время", "ПредпочтительноеВремяРаботы", 23, Ложь)
    СоздатьКолонку(Профиль, "Предпочтительный сотрудник", "ПредпочтительныйСотрудник", 24, Ложь)
;

@НаСервере @ДоступноСКлиента
статический метод ЕстьКолонкиСписка(Профиль: ПользователиПриложения.Ссылка?): Булево
    знч Идентификатор = "Обращения"
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено() != Неопределено
;

@НаСервере
статический метод СоздатьКолонку(Профиль: ПользователиПриложения.Ссылка?, Заголовок: Строка, Ключ: Строка, Порядок: Число, Видимость: Булево)
    знч Идентификатор = "Обращения"
    знч Объект = новый КолонкиСписков.Объект()
    Объект.Наименование = Заголовок
    Объект.Пользователь = Профиль
    Объект.ИдентификаторСписка = Идентификатор
    Объект.КлючКолонки = Ключ
    Объект.ЗаголовокКолонки = Заголовок
    Объект.ПорядокКолонки = Порядок
    Объект.ВидимостьКолонки = Видимость
    Объект.Записать()
;
