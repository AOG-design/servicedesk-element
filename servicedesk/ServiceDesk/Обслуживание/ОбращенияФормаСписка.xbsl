// Обработчики формы списка "Обращения": персональные настройки колонок.

@Обработчик
метод ПослеСоздания()
    ЗагрузитьНастройкуКолонок()
;

метод ЗагрузитьНастройкуКолонок()
    знч Значения = ПрочитатьНастройку()
    если Значения == Неопределено
        возврат
    ;

    Дата = (Значения.Получить(0) как Булево)
    Номер = (Значения.Получить(1) как Булево)
    Контрагент = (Значения.Получить(2) как Булево)
    Направление = (Значения.Получить(3) как Булево)
    Срочность = (Значения.Получить(4) как Булево)
    Статус = (Значения.Получить(5) как Булево)
    Исполнитель = (Значения.Получить(6) как Булево)
    КонтактноеЛицо = (Значения.Получить(7) как Булево)
    Телефон = (Значения.Получить(8) как Булево)
    МобильныйТелефон = (Значения.Получить(9) как Булево)
    КодГорода = (Значения.Получить(10) как Булево)
    Добавочный = (Значения.Получить(11) как Булево)
    НомерВходящий = (Значения.Получить(12) как Булево)
    ОбслОрганизация = (Значения.Получить(13) как Булево)
    ПользовательОбращения = (Значения.Получить(14) как Булево)
    НовыйКонтрагент = (Значения.Получить(15) как Булево)
    Уведомление = (Значения.Получить(16) как Булево)
    НаправлениеЗаказчика = (Значения.Получить(17) как Булево)
    ОписаниеЗаказчика = (Значения.Получить(18) как Булево)
    СрочностьЗаказчика = (Значения.Получить(19) как Булево)
    ОписаниеИсполнителя = (Значения.Получить(20) как Булево)
    ПредпочтДата = (Значения.Получить(21) как Булево)
    ПредпочтВремя = (Значения.Получить(22) как Булево)
    ПредпочтСотрудник = (Значения.Получить(23) как Булево)
;

метод СохранитьНастройкуКолонок(Источник: Кнопка, Событие: СобытиеПриНажатии)
    знч Значения = новый Массив<Булево>()
    Значения.Добавить(Дата)
    Значения.Добавить(Номер)
    Значения.Добавить(Контрагент)
    Значения.Добавить(Направление)
    Значения.Добавить(Срочность)
    Значения.Добавить(Статус)
    Значения.Добавить(Исполнитель)
    Значения.Добавить(КонтактноеЛицо)
    Значения.Добавить(Телефон)
    Значения.Добавить(МобильныйТелефон)
    Значения.Добавить(КодГорода)
    Значения.Добавить(Добавочный)
    Значения.Добавить(НомерВходящий)
    Значения.Добавить(ОбслОрганизация)
    Значения.Добавить(ПользовательОбращения)
    Значения.Добавить(НовыйКонтрагент)
    Значения.Добавить(Уведомление)
    Значения.Добавить(НаправлениеЗаказчика)
    Значения.Добавить(ОписаниеЗаказчика)
    Значения.Добавить(СрочностьЗаказчика)
    Значения.Добавить(ОписаниеИсполнителя)
    Значения.Добавить(ПредпочтДата)
    Значения.Добавить(ПредпочтВремя)
    Значения.Добавить(ПредпочтСотрудник)
    ЗаписатьНастройку(Значения)
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьНастройку(): Массив<Булево>?
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Дата,
            Номер,
            Контрагент,
            Направление,
            Срочность,
            Статус,
            Исполнитель,
            КонтактноеЛицо,
            Телефон,
            МобильныйТелефон,
            КодГорода,
            Добавочный,
            НомерВходящий,
            ОбслОрганизация,
            ПользовательОбращения,
            НовыйКонтрагент,
            Уведомление,
            НаправлениеЗаказчика,
            ОписаниеЗаказчика,
            СрочностьЗаказчика,
            ОписаниеИсполнителя,
            ПредпочтДата,
            ПредпочтВремя,
            ПредпочтСотрудник
        ИЗ
            НастройкиКолонокОбращений
        ГДЕ
            Пользователь == %Профиль
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат Неопределено
    ;

    знч Результат = новый Массив<Булево>()
    Результат.Добавить(Строка.Дата)
    Результат.Добавить(Строка.Номер)
    Результат.Добавить(Строка.Контрагент)
    Результат.Добавить(Строка.Направление)
    Результат.Добавить(Строка.Срочность)
    Результат.Добавить(Строка.Статус)
    Результат.Добавить(Строка.Исполнитель)
    Результат.Добавить(Строка.КонтактноеЛицо)
    Результат.Добавить(Строка.Телефон)
    Результат.Добавить(Строка.МобильныйТелефон)
    Результат.Добавить(Строка.КодГорода)
    Результат.Добавить(Строка.Добавочный)
    Результат.Добавить(Строка.НомерВходящий)
    Результат.Добавить(Строка.ОбслОрганизация)
    Результат.Добавить(Строка.ПользовательОбращения)
    Результат.Добавить(Строка.НовыйКонтрагент)
    Результат.Добавить(Строка.Уведомление)
    Результат.Добавить(Строка.НаправлениеЗаказчика)
    Результат.Добавить(Строка.ОписаниеЗаказчика)
    Результат.Добавить(Строка.СрочностьЗаказчика)
    Результат.Добавить(Строка.ОписаниеИсполнителя)
    Результат.Добавить(Строка.ПредпочтДата)
    Результат.Добавить(Строка.ПредпочтВремя)
    Результат.Добавить(Строка.ПредпочтСотрудник)
    возврат Результат
;

@НаСервере @ДоступноСКлиента
статический метод ЗаписатьНастройку(Значения: Массив<Булево>)
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;

    знч Существующая = НастройкаПоПрофилю(Профиль)
    если Существующая == Неопределено
        знч Новая = новый НастройкиКолонокОбращений.Объект()
        Новая.Наименование = "Настройки колонок: " + Профиль.Представление()
        Новая.Пользователь = Профиль
        ЗаполнитьКолонки(Новая, Значения)
        Новая.Записать()
        возврат
    ;

    знч ОбъектНастройки = Существующая.ЗагрузитьОбъект()
    если ОбъектНастройки == Неопределено
        возврат
    ;
    ЗаполнитьКолонки(ОбъектНастройки, Значения)
    ОбъектНастройки.Записать()
;

@НаСервере
статический метод ЗаполнитьКолонки(Настройка: НастройкиКолонокОбращений.Объект, Значения: Массив<Булево>)
    Настройка.Дата = Значения.Получить(0) как Булево
    Настройка.Номер = Значения.Получить(1) как Булево
    Настройка.Контрагент = Значения.Получить(2) как Булево
    Настройка.Направление = Значения.Получить(3) как Булево
    Настройка.Срочность = Значения.Получить(4) как Булево
    Настройка.Статус = Значения.Получить(5) как Булево
    Настройка.Исполнитель = Значения.Получить(6) как Булево
    Настройка.КонтактноеЛицо = Значения.Получить(7) как Булево
    Настройка.Телефон = Значения.Получить(8) как Булево
    Настройка.МобильныйТелефон = Значения.Получить(9) как Булево
    Настройка.КодГорода = Значения.Получить(10) как Булево
    Настройка.Добавочный = Значения.Получить(11) как Булево
    Настройка.НомерВходящий = Значения.Получить(12) как Булево
    Настройка.ОбслОрганизация = Значения.Получить(13) как Булево
    Настройка.ПользовательОбращения = Значения.Получить(14) как Булево
    Настройка.НовыйКонтрагент = Значения.Получить(15) как Булево
    Настройка.Уведомление = Значения.Получить(16) как Булево
    Настройка.НаправлениеЗаказчика = Значения.Получить(17) как Булево
    Настройка.ОписаниеЗаказчика = Значения.Получить(18) как Булево
    Настройка.СрочностьЗаказчика = Значения.Получить(19) как Булево
    Настройка.ОписаниеИсполнителя = Значения.Получить(20) как Булево
    Настройка.ПредпочтДата = Значения.Получить(21) как Булево
    Настройка.ПредпочтВремя = Значения.Получить(22) как Булево
    Настройка.ПредпочтСотрудник = Значения.Получить(23) как Булево
;

@НаСервере
статический метод НастройкаПоПрофилю(Профиль: ПользователиПриложения.Ссылка?): НастройкиКолонокОбращений.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            НастройкиКолонокОбращений
        ГДЕ
            Пользователь == %Профиль
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено()?.Ссылка
;

@НаСервере
статический метод ТекущийПрофиль(): ПользователиПриложения.Ссылка?
    знч УчетнаяЗапись = Пользователи.ТекущийПользователь
    если УчетнаяЗапись == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            ПользователиПриложения
        ГДЕ
            УчетнаяЗапись == %УчетнаяЗапись
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено()?.Ссылка
;
