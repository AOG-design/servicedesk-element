// Обработчики формы списка "Обращения": колонки из справочника КолонкиСписков.

@Обработчик
метод ПослеСоздания()
    ОбеспечитьКолонкиСписка()
    ЗагрузитьНастройкуКолонок()
    ПрименитьПорядокКолонок(СобратьПорядок())
;

метод ПрименитьНастройки(Источник: Кнопка, Событие: СобытиеПриНажатии)
    НормализоватьПорядок()
    ЗагрузитьНастройкуКолонок()
    ПрименитьПорядокКолонок(СобратьПорядок())
;

// ---------------------- порядок ----------------------

метод СобратьПорядок(): Массив<Число>
    знч Итог = новый Массив<Число>()
    пер Шаг = 1
    пока Шаг <= 24
        если ПозДата == Шаг и не Итог.Содержит(0)
            Итог.Добавить(0)
        ;
        если ПозНомер == Шаг и не Итог.Содержит(1)
            Итог.Добавить(1)
        ;
        если ПозКонтрагент == Шаг и не Итог.Содержит(2)
            Итог.Добавить(2)
        ;
        если ПозНаправление == Шаг и не Итог.Содержит(3)
            Итог.Добавить(3)
        ;
        если ПозСрочность == Шаг и не Итог.Содержит(4)
            Итог.Добавить(4)
        ;
        если ПозСтатус == Шаг и не Итог.Содержит(5)
            Итог.Добавить(5)
        ;
        если ПозИсполнитель == Шаг и не Итог.Содержит(6)
            Итог.Добавить(6)
        ;
        если ПозКонтактноеЛицо == Шаг и не Итог.Содержит(7)
            Итог.Добавить(7)
        ;
        если ПозТелефон == Шаг и не Итог.Содержит(8)
            Итог.Добавить(8)
        ;
        если ПозМобильныйТелефон == Шаг и не Итог.Содержит(9)
            Итог.Добавить(9)
        ;
        если ПозКодГорода == Шаг и не Итог.Содержит(10)
            Итог.Добавить(10)
        ;
        если ПозДобавочный == Шаг и не Итог.Содержит(11)
            Итог.Добавить(11)
        ;
        если ПозНомерВходящий == Шаг и не Итог.Содержит(12)
            Итог.Добавить(12)
        ;
        если ПозОбслОрганизация == Шаг и не Итог.Содержит(13)
            Итог.Добавить(13)
        ;
        если ПозПользовательОбращения == Шаг и не Итог.Содержит(14)
            Итог.Добавить(14)
        ;
        если ПозНовыйКонтрагент == Шаг и не Итог.Содержит(15)
            Итог.Добавить(15)
        ;
        если ПозУведомление == Шаг и не Итог.Содержит(16)
            Итог.Добавить(16)
        ;
        если ПозНаправлениеЗаказчика == Шаг и не Итог.Содержит(17)
            Итог.Добавить(17)
        ;
        если ПозОписаниеЗаказчика == Шаг и не Итог.Содержит(18)
            Итог.Добавить(18)
        ;
        если ПозСрочностьЗаказчика == Шаг и не Итог.Содержит(19)
            Итог.Добавить(19)
        ;
        если ПозОписаниеИсполнителя == Шаг и не Итог.Содержит(20)
            Итог.Добавить(20)
        ;
        если ПозПредпочтДата == Шаг и не Итог.Содержит(21)
            Итог.Добавить(21)
        ;
        если ПозПредпочтВремя == Шаг и не Итог.Содержит(22)
            Итог.Добавить(22)
        ;
        если ПозПредпочтСотрудник == Шаг и не Итог.Содержит(23)
            Итог.Добавить(23)
        ;
        Шаг = Шаг + 1
    ;
    если не Итог.Содержит(0)
        Итог.Добавить(0)
    ;
    если не Итог.Содержит(1)
        Итог.Добавить(1)
    ;
    если не Итог.Содержит(2)
        Итог.Добавить(2)
    ;
    если не Итог.Содержит(3)
        Итог.Добавить(3)
    ;
    если не Итог.Содержит(4)
        Итог.Добавить(4)
    ;
    если не Итог.Содержит(5)
        Итог.Добавить(5)
    ;
    если не Итог.Содержит(6)
        Итог.Добавить(6)
    ;
    если не Итог.Содержит(7)
        Итог.Добавить(7)
    ;
    если не Итог.Содержит(8)
        Итог.Добавить(8)
    ;
    если не Итог.Содержит(9)
        Итог.Добавить(9)
    ;
    если не Итог.Содержит(10)
        Итог.Добавить(10)
    ;
    если не Итог.Содержит(11)
        Итог.Добавить(11)
    ;
    если не Итог.Содержит(12)
        Итог.Добавить(12)
    ;
    если не Итог.Содержит(13)
        Итог.Добавить(13)
    ;
    если не Итог.Содержит(14)
        Итог.Добавить(14)
    ;
    если не Итог.Содержит(15)
        Итог.Добавить(15)
    ;
    если не Итог.Содержит(16)
        Итог.Добавить(16)
    ;
    если не Итог.Содержит(17)
        Итог.Добавить(17)
    ;
    если не Итог.Содержит(18)
        Итог.Добавить(18)
    ;
    если не Итог.Содержит(19)
        Итог.Добавить(19)
    ;
    если не Итог.Содержит(20)
        Итог.Добавить(20)
    ;
    если не Итог.Содержит(21)
        Итог.Добавить(21)
    ;
    если не Итог.Содержит(22)
        Итог.Добавить(22)
    ;
    если не Итог.Содержит(23)
        Итог.Добавить(23)
    ;
    возврат Итог
;

метод ПрименитьПорядокКолонок(Порядок: Массив<Число>)
    знч Итог = новый Массив<КолонкаТаблицы<СтрокаДинамическогоСписка<ОбращенияФормаСписка.ДанныеСтрокиСписка>>>()
    пер К = 0
    пока К < 24
        пер Индекс = Порядок.Получить(К)
        если Индекс == 0
            Итог.Добавить(Компоненты.КолДата)
        ;
        если Индекс == 1
            Итог.Добавить(Компоненты.КолНомер)
        ;
        если Индекс == 2
            Итог.Добавить(Компоненты.КолКонтрагент)
        ;
        если Индекс == 3
            Итог.Добавить(Компоненты.КолНаправление)
        ;
        если Индекс == 4
            Итог.Добавить(Компоненты.КолСрочность)
        ;
        если Индекс == 5
            Итог.Добавить(Компоненты.КолСтатус)
        ;
        если Индекс == 6
            Итог.Добавить(Компоненты.КолИсполнитель)
        ;
        если Индекс == 7
            Итог.Добавить(Компоненты.КолКонтактноеЛицо)
        ;
        если Индекс == 8
            Итог.Добавить(Компоненты.КолТелефон)
        ;
        если Индекс == 9
            Итог.Добавить(Компоненты.КолМобильныйТелефон)
        ;
        если Индекс == 10
            Итог.Добавить(Компоненты.КолКодГорода)
        ;
        если Индекс == 11
            Итог.Добавить(Компоненты.КолДобавочный)
        ;
        если Индекс == 12
            Итог.Добавить(Компоненты.КолНомерВходящий)
        ;
        если Индекс == 13
            Итог.Добавить(Компоненты.КолОбслОрганизация)
        ;
        если Индекс == 14
            Итог.Добавить(Компоненты.КолПользовательОбращения)
        ;
        если Индекс == 15
            Итог.Добавить(Компоненты.КолНовыйКонтрагент)
        ;
        если Индекс == 16
            Итог.Добавить(Компоненты.КолУведомление)
        ;
        если Индекс == 17
            Итог.Добавить(Компоненты.КолНаправлениеЗаказчика)
        ;
        если Индекс == 18
            Итог.Добавить(Компоненты.КолОписаниеЗаказчика)
        ;
        если Индекс == 19
            Итог.Добавить(Компоненты.КолСрочностьЗаказчика)
        ;
        если Индекс == 20
            Итог.Добавить(Компоненты.КолОписаниеИсполнителя)
        ;
        если Индекс == 21
            Итог.Добавить(Компоненты.КолПредпочтДата)
        ;
        если Индекс == 22
            Итог.Добавить(Компоненты.КолПредпочтВремя)
        ;
        если Индекс == 23
            Итог.Добавить(Компоненты.КолПредпочтСотрудник)
        ;
        К = К + 1
    ;
    Компоненты.ОсновнаяТаблица.Колонки = Итог
;

// ---------------------- чтение настроек ----------------------

метод ЗагрузитьНастройкуКолонок()
    знч Видимость = ПрочитатьВидимость()
    если Видимость != Неопределено
        Дата = (Видимость.Получить(0) как Булево)
        Номер = (Видимость.Получить(1) как Булево)
        Контрагент = (Видимость.Получить(2) как Булево)
        Направление = (Видимость.Получить(3) как Булево)
        Срочность = (Видимость.Получить(4) как Булево)
        Статус = (Видимость.Получить(5) как Булево)
        Исполнитель = (Видимость.Получить(6) как Булево)
        КонтактноеЛицо = (Видимость.Получить(7) как Булево)
        Телефон = (Видимость.Получить(8) как Булево)
        МобильныйТелефон = (Видимость.Получить(9) как Булево)
        КодГорода = (Видимость.Получить(10) как Булево)
        Добавочный = (Видимость.Получить(11) как Булево)
        НомерВходящий = (Видимость.Получить(12) как Булево)
        ОбслОрганизация = (Видимость.Получить(13) как Булево)
        ПользовательОбращения = (Видимость.Получить(14) как Булево)
        НовыйКонтрагент = (Видимость.Получить(15) как Булево)
        Уведомление = (Видимость.Получить(16) как Булево)
        НаправлениеЗаказчика = (Видимость.Получить(17) как Булево)
        ОписаниеЗаказчика = (Видимость.Получить(18) как Булево)
        СрочностьЗаказчика = (Видимость.Получить(19) как Булево)
        ОписаниеИсполнителя = (Видимость.Получить(20) как Булево)
        ПредпочтДата = (Видимость.Получить(21) как Булево)
        ПредпочтВремя = (Видимость.Получить(22) как Булево)
        ПредпочтСотрудник = (Видимость.Получить(23) как Булево)
    ;

    знч Позиции = ПрочитатьПозиции()
    если Позиции != Неопределено
        ПозДата = (Позиции.Получить(0) как Число)
        ПозНомер = (Позиции.Получить(1) как Число)
        ПозКонтрагент = (Позиции.Получить(2) как Число)
        ПозНаправление = (Позиции.Получить(3) как Число)
        ПозСрочность = (Позиции.Получить(4) как Число)
        ПозСтатус = (Позиции.Получить(5) как Число)
        ПозИсполнитель = (Позиции.Получить(6) как Число)
        ПозКонтактноеЛицо = (Позиции.Получить(7) как Число)
        ПозТелефон = (Позиции.Получить(8) как Число)
        ПозМобильныйТелефон = (Позиции.Получить(9) как Число)
        ПозКодГорода = (Позиции.Получить(10) как Число)
        ПозДобавочный = (Позиции.Получить(11) как Число)
        ПозНомерВходящий = (Позиции.Получить(12) как Число)
        ПозОбслОрганизация = (Позиции.Получить(13) как Число)
        ПозПользовательОбращения = (Позиции.Получить(14) как Число)
        ПозНовыйКонтрагент = (Позиции.Получить(15) как Число)
        ПозУведомление = (Позиции.Получить(16) как Число)
        ПозНаправлениеЗаказчика = (Позиции.Получить(17) как Число)
        ПозОписаниеЗаказчика = (Позиции.Получить(18) как Число)
        ПозСрочностьЗаказчика = (Позиции.Получить(19) как Число)
        ПозОписаниеИсполнителя = (Позиции.Получить(20) как Число)
        ПозПредпочтДата = (Позиции.Получить(21) как Число)
        ПозПредпочтВремя = (Позиции.Получить(22) как Число)
        ПозПредпочтСотрудник = (Позиции.Получить(23) как Число)
    ;
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьПозиции(): Массив<Число>?
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат Неопределено
    ;

    знч Идентификатор = "Обращения"
    знч Запрос = Запрос{
        ВЫБРАТЬ
            КлючКолонки,
            ПорядокКолонки
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
    }

    знч Позиции = новый Массив<Число>()
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)
    Позиции.Добавить(0)

    для Строка из Запрос.Выполнить()
        если Строка.КлючКолонки == "Дата"
            Позиции.Установить(0, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "Номер"
            Позиции.Установить(1, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "Контрагент"
            Позиции.Установить(2, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "НаправлениеРаботыКлассифицированное"
            Позиции.Установить(3, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "СрочностьКлассифицированная"
            Позиции.Установить(4, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "Статус"
            Позиции.Установить(5, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "Исполнитель"
            Позиции.Установить(6, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "КонтактноеЛицо"
            Позиции.Установить(7, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ТелефонКонтактногоЛица"
            Позиции.Установить(8, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "МобильныйТелефонКонтактногоЛица"
            Позиции.Установить(9, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "КодГорода"
            Позиции.Установить(10, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ДобавочныйНомер"
            Позиции.Установить(11, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "НомерОбращенияВходящий"
            Позиции.Установить(12, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ОбслуживаемаяОрганизация"
            Позиции.Установить(13, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "Пользователь"
            Позиции.Установить(14, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ПризнакНовогоКонтрагента"
            Позиции.Установить(15, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "УведомлениеОтправлено"
            Позиции.Установить(16, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "НаправлениеРаботыСоСловЗаказчика"
            Позиции.Установить(17, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ОписаниеПроблемыСоСловЗаказчика"
            Позиции.Установить(18, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "СрочностьСоСловЗаказчика"
            Позиции.Установить(19, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ОписаниеПроблемыКлассифицированное"
            Позиции.Установить(20, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ПредпочтительнаяДатаНачала"
            Позиции.Установить(21, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ПредпочтительноеВремяРаботы"
            Позиции.Установить(22, Строка.ПорядокКолонки)
        ;
        если Строка.КлючКолонки == "ПредпочтительныйСотрудник"
            Позиции.Установить(23, Строка.ПорядокКолонки)
        ;
    ;
    возврат Позиции
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьВидимость(): Массив<Булево>?
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат Неопределено
    ;

    знч Идентификатор = "Обращения"
    знч Запрос = Запрос{
        ВЫБРАТЬ
            КлючКолонки,
            ВидимостьКолонки
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
    }

    знч Видимость = новый Массив<Булево>()
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)
    Видимость.Добавить(Ложь)

    для Строка из Запрос.Выполнить()
        если Строка.КлючКолонки == "Дата"
            Видимость.Установить(0, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "Номер"
            Видимость.Установить(1, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "Контрагент"
            Видимость.Установить(2, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "НаправлениеРаботыКлассифицированное"
            Видимость.Установить(3, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "СрочностьКлассифицированная"
            Видимость.Установить(4, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "Статус"
            Видимость.Установить(5, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "Исполнитель"
            Видимость.Установить(6, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "КонтактноеЛицо"
            Видимость.Установить(7, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ТелефонКонтактногоЛица"
            Видимость.Установить(8, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "МобильныйТелефонКонтактногоЛица"
            Видимость.Установить(9, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "КодГорода"
            Видимость.Установить(10, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ДобавочныйНомер"
            Видимость.Установить(11, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "НомерОбращенияВходящий"
            Видимость.Установить(12, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ОбслуживаемаяОрганизация"
            Видимость.Установить(13, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "Пользователь"
            Видимость.Установить(14, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ПризнакНовогоКонтрагента"
            Видимость.Установить(15, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "УведомлениеОтправлено"
            Видимость.Установить(16, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "НаправлениеРаботыСоСловЗаказчика"
            Видимость.Установить(17, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ОписаниеПроблемыСоСловЗаказчика"
            Видимость.Установить(18, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "СрочностьСоСловЗаказчика"
            Видимость.Установить(19, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ОписаниеПроблемыКлассифицированное"
            Видимость.Установить(20, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ПредпочтительнаяДатаНачала"
            Видимость.Установить(21, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ПредпочтительноеВремяРаботы"
            Видимость.Установить(22, Строка.ВидимостьКолонки)
        ;
        если Строка.КлючКолонки == "ПредпочтительныйСотрудник"
            Видимость.Установить(23, Строка.ВидимостьКолонки)
        ;
    ;
    возврат Видимость
;

// ---------------------- справочник колонок ----------------------

@НаСервере @ДоступноСКлиента
статический метод ОбеспечитьКолонкиСписка()
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;
    если ЕстьКолонкиСписка(Профиль)
        возврат
    ;
    СоздатьКолонку(Профиль, "Дата", "Дата", 1, Истина)
    СоздатьКолонку(Профиль, "Номер", "Номер", 2, Истина)
    СоздатьКолонку(Профиль, "Контрагент", "Контрагент", 3, Истина)
    СоздатьКолонку(Профиль, "НаправлениеРаботыКлассифицированное", "НаправлениеРаботыКлассифицированное", 4, Истина)
    СоздатьКолонку(Профиль, "СрочностьКлассифицированная", "СрочностьКлассифицированная", 5, Истина)
    СоздатьКолонку(Профиль, "Статус", "Статус", 6, Истина)
    СоздатьКолонку(Профиль, "Исполнитель", "Исполнитель", 7, Истина)
    СоздатьКолонку(Профиль, "КонтактноеЛицо", "КонтактноеЛицо", 8, Ложь)
    СоздатьКолонку(Профиль, "ТелефонКонтактногоЛица", "ТелефонКонтактногоЛица", 9, Ложь)
    СоздатьКолонку(Профиль, "МобильныйТелефонКонтактногоЛица", "МобильныйТелефонКонтактногоЛица", 10, Ложь)
    СоздатьКолонку(Профиль, "КодГорода", "КодГорода", 11, Ложь)
    СоздатьКолонку(Профиль, "ДобавочныйНомер", "ДобавочныйНомер", 12, Ложь)
    СоздатьКолонку(Профиль, "НомерОбращенияВходящий", "НомерОбращенияВходящий", 13, Ложь)
    СоздатьКолонку(Профиль, "ОбслуживаемаяОрганизация", "ОбслуживаемаяОрганизация", 14, Ложь)
    СоздатьКолонку(Профиль, "Пользователь", "Пользователь", 15, Ложь)
    СоздатьКолонку(Профиль, "ПризнакНовогоКонтрагента", "ПризнакНовогоКонтрагента", 16, Ложь)
    СоздатьКолонку(Профиль, "УведомлениеОтправлено", "УведомлениеОтправлено", 17, Ложь)
    СоздатьКолонку(Профиль, "НаправлениеРаботыСоСловЗаказчика", "НаправлениеРаботыСоСловЗаказчика", 18, Ложь)
    СоздатьКолонку(Профиль, "ОписаниеПроблемыСоСловЗаказчика", "ОписаниеПроблемыСоСловЗаказчика", 19, Ложь)
    СоздатьКолонку(Профиль, "СрочностьСоСловЗаказчика", "СрочностьСоСловЗаказчика", 20, Ложь)
    СоздатьКолонку(Профиль, "ОписаниеПроблемыКлассифицированное", "ОписаниеПроблемыКлассифицированное", 21, Ложь)
    СоздатьКолонку(Профиль, "ПредпочтительнаяДатаНачала", "ПредпочтительнаяДатаНачала", 22, Ложь)
    СоздатьКолонку(Профиль, "ПредпочтительноеВремяРаботы", "ПредпочтительноеВремяРаботы", 23, Ложь)
    СоздатьКолонку(Профиль, "ПредпочтительныйСотрудник", "ПредпочтительныйСотрудник", 24, Ложь)
;

@НаСервере @ДоступноСКлиента
статический метод ЕстьКолонкиСписка(Профиль: ПользователиПриложения.Ссылка?): Булево
    знч Идентификатор = "Обращения"
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено() != Неопределено
;

@НаСервере
статический метод СоздатьКолонку(Профиль: ПользователиПриложения.Ссылка?, Заголовок: Строка, Ключ: Строка, Порядок: Число, Видимость: Булево)
    знч Идентификатор = "Обращения"
    знч Объект = новый КолонкиСписков.Объект()
    Объект.Наименование = Заголовок
    Объект.Пользователь = Профиль
    Объект.ИдентификаторСписка = Идентификатор
    Объект.КлючКолонки = Ключ
    Объект.ЗаголовокКолонки = Заголовок
    Объект.ПорядокКолонки = Порядок
    Объект.ВидимостьКолонки = Видимость
    Объект.Записать()
;

@НаСервере
статический метод ТекущийПрофиль(): ПользователиПриложения.Ссылка?
    знч УчетнаяЗапись = Пользователи.ТекущийПользователь
    если УчетнаяЗапись == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            ПользователиПриложения
        ГДЕ
            УчетнаяЗапись == %УчетнаяЗапись
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено()?.Ссылка
;

// Перенумеровывает колонки 1..N, устраняя одинаковые позиции.
@НаСервере @ДоступноСКлиента
статический метод НормализоватьПорядок()
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;

    знч Идентификатор = "Обращения"
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Ссылка
        ИЗ
            КолонкиСписков
        ГДЕ
            Пользователь == %Профиль
            И ИдентификаторСписка == %Идентификатор
        УПОРЯДОЧИТЬ ПО
            ПорядокКолонки,
            ЗаголовокКолонки
    }

    пер Номер = 1
    для Строка из Запрос.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект()
        если Объект == Неопределено
            продолжать
        ;
        если Объект.ПорядокКолонки != Номер
            Объект.ПорядокКолонки = Номер
            Объект.Записать()
        ;
        Номер = Номер + 1
    ;
;
