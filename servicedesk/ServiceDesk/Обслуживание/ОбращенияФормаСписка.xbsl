// Обработчики формы списка "Обращения": персональные настройки колонок.

@Обработчик
метод ПослеСоздания()
    ЗагрузитьНастройкуКолонок()
;

метод ЗагрузитьНастройкуКолонок()
    знч Значения = ПрочитатьНастройку()
    если Значения == Неопределено
        возврат
    ;

    КолонкаДата = (Значения.Получить(0) как Булево)
    КолонкаНомер = (Значения.Получить(1) как Булево)
    КолонкаКонтрагент = (Значения.Получить(2) как Булево)
    КолонкаНаправление = (Значения.Получить(3) как Булево)
    КолонкаСрочность = (Значения.Получить(4) как Булево)
    КолонкаСтатус = (Значения.Получить(5) как Булево)
    КолонкаИсполнитель = (Значения.Получить(6) как Булево)
;

метод СохранитьНастройкуКолонок(Источник: Кнопка, Событие: СобытиеПриНажатии)
    знч Значения = новый Массив<Булево>()
    Значения.Добавить(КолонкаДата)
    Значения.Добавить(КолонкаНомер)
    Значения.Добавить(КолонкаКонтрагент)
    Значения.Добавить(КолонкаНаправление)
    Значения.Добавить(КолонкаСрочность)
    Значения.Добавить(КолонкаСтатус)
    Значения.Добавить(КолонкаИсполнитель)
    ЗаписатьНастройку(Значения)
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьНастройку(): Массив<Булево>?
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            КолонкаДата,
            КолонкаНомер,
            КолонкаКонтрагент,
            КолонкаНаправление,
            КолонкаСрочность,
            КолонкаСтатус,
            КолонкаИсполнитель
        ИЗ
            НастройкиКолонокОбращений
        ГДЕ
            Пользователь == %Профиль
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат Неопределено
    ;

    знч Результат = новый Массив<Булево>()
    Результат.Добавить(Строка.КолонкаДата)
    Результат.Добавить(Строка.КолонкаНомер)
    Результат.Добавить(Строка.КолонкаКонтрагент)
    Результат.Добавить(Строка.КолонкаНаправление)
    Результат.Добавить(Строка.КолонкаСрочность)
    Результат.Добавить(Строка.КолонкаСтатус)
    Результат.Добавить(Строка.КолонкаИсполнитель)
    возврат Результат
;

@НаСервере @ДоступноСКлиента
статический метод ЗаписатьНастройку(Значения: Массив<Булево>)
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;

    знч Существующая = НастройкаПоПрофилю(Профиль)
    если Существующая == Неопределено
        знч Новая = новый НастройкиКолонокОбращений.Объект()
        Новая.Пользователь = Профиль
        ЗаполнитьКолонки(Новая, Значения)
        Новая.Записать()
        возврат
    ;

    знч ОбъектНастройки = Существующая.ЗагрузитьОбъект()
    если ОбъектНастройки == Неопределено
        возврат
    ;
    ЗаполнитьКолонки(ОбъектНастройки, Значения)
    ОбъектНастройки.Записать()
;

@НаСервере
статический метод ЗаполнитьКолонки(Настройка: НастройкиКолонокОбращений.Объект, Значения: Массив<Булево>)
    Настройка.КолонкаДата = Значения.Получить(0) как Булево
    Настройка.КолонкаНомер = Значения.Получить(1) как Булево
    Настройка.КолонкаКонтрагент = Значения.Получить(2) как Булево
    Настройка.КолонкаНаправление = Значения.Получить(3) как Булево
    Настройка.КолонкаСрочность = Значения.Получить(4) как Булево
    Настройка.КолонкаСтатус = Значения.Получить(5) как Булево
    Настройка.КолонкаИсполнитель = Значения.Получить(6) как Булево
;

@НаСервере
статический метод НастройкаПоПрофилю(Профиль: ПользователиПриложения.Ссылка?): НастройкиКолонокОбращений.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            НастройкиКолонокОбращений
        ГДЕ
            Пользователь == %Профиль
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено()?.Ссылка
;

@НаСервере
статический метод ТекущийПрофиль(): ПользователиПриложения.Ссылка?
    знч УчетнаяЗапись = Пользователи.ТекущийПользователь
    если УчетнаяЗапись == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            ПользователиПриложения
        ГДЕ
            УчетнаяЗапись == %УчетнаяЗапись
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено()?.Ссылка
;
