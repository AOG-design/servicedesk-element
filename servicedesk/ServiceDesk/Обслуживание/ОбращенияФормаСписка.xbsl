    Настройка.НомерВходящий = Видимость.Получить(12) как Булево
    Настройка.ОбслОрганизация = Видимость.Получить(13) как Булево
    Настройка.ПользовательОбращения = Видимость.Получить(14) как Булево
    Настройка.НовыйКонтрагент = Видимость.Получить(15) как Булево
    Настройка.Уведомление = Видимость.Получить(16) как Булево
    Настройка.НаправлениеЗаказчика = Видимость.Получить(17) как Булево
    Настройка.ОписаниеЗаказчика = Видимость.Получить(18) как Булево
    Настройка.СрочностьЗаказчика = Видимость.Получить(19) как Булево
    Настройка.ОписаниеИсполнителя = Видимость.Получить(20) как Булево
    Настройка.ПредпочтДата = Видимость.Получить(21) как Булево
    Настройка.ПредпочтВремя = Видимость.Получить(22) как Булево
    Настройка.ПредпочтСотрудник = Видимость.Получить(23) как Булево
    Настройка.ПозДата = Позиции.Получить(0) как Число
    Настройка.ПозНомер = Позиции.Получить(1) как Число
    Настройка.ПозКонтрагент = Позиции.Получить(2) как Число
    Настройка.ПозНаправление = Позиции.Получить(3) как Число
    Настройка.ПозСрочность = Позиции.Получить(4) как Число
    Настройка.ПозСтатус = Позиции.Получить(5) как Число
    Настройка.ПозИсполнитель = Позиции.Получить(6) как Число
    Настройка.ПозКонтактноеЛицо = Позиции.Получить(7) как Число
    Настройка.ПозТелефон = Позиции.Получить(8) как Число
    Настройка.ПозМобильныйТелефон = Позиции.Получить(9) как Число
    Настройка.ПозКодГорода = Позиции.Получить(10) как Число
    Настройка.ПозДобавочный = Позиции.Получить(11) как Число
    Настройка.ПозНомерВходящий = Позиции.Получить(12) как Число
    Настройка.ПозОбслОрганизация = Позиции.Получить(13) как Число
    Настройка.ПозПользовательОбращения = Позиции.Получить(14) как Число
    Настройка.ПозНовыйКонтрагент = Позиции.Получить(15) как Число
    Настройка.ПозУведомление = Позиции.Получить(16) как Число
    Настройка.ПозНаправлениеЗаказчика = Позиции.Получить(17) как Число
    Настройка.ПозОписаниеЗаказчика = Позиции.Получить(18) как Число
    Настройка.ПозСрочностьЗаказчика = Позиции.Получить(19) как Число
    Настройка.ПозОписаниеИсполнителя = Позиции.Получить(20) как Число
    Настройка.ПозПредпочтДата = Позиции.Получить(21) как Число
    Настройка.ПозПредпочтВремя = Позиции.Получить(22) как Число
    Настройка.ПозПредпочтСотрудник = Позиции.Получить(23) как Число
;

@НаСервере
статический метод НастройкаПоПрофилю(Профиль: ПользователиПриложения.Ссылка?): НастройкиКолонокОбращений.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            НастройкиКолонокОбращений
        ГДЕ
            Пользователь == %Профиль
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено()?.Ссылка
;

@НаСервере
статический метод ТекущийПрофиль(): ПользователиПриложения.Ссылка?
    знч УчетнаяЗапись = Пользователи.ТекущийПользователь
    если УчетнаяЗапись == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Ссылка
        ИЗ
            ПользователиПриложения
        ГДЕ
            УчетнаяЗапись == %УчетнаяЗапись
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено()?.Ссылка
;
