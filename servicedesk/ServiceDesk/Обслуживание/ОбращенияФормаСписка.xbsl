@НаСервере @ДоступноСКлиента
статический метод ЗаписатьНастройку(Видимость: Массив<Булево>, Позиции: Массив<Число>)
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат
    ;

    знч Существующая = НастройкаПоПрофилю(Профиль)
    если Существующая == Неопределено
        знч Новая = новый НастройкиКолонокОбращений.Объект()
        Новая.Наименование = "Настройки колонок: " + Профиль.Представление()
        Новая.Пользователь = Профиль
        Заполнить(Новая, Видимость, Позиции)
        Новая.Записать()
        возврат
    ;

    знч ОбъектНастройки = Существующая.ЗагрузитьОбъект()
    если ОбъектНастройки == Неопределено
        возврат
    ;
    Заполнить(ОбъектНастройки, Видимость, Позиции)
    ОбъектНастройки.Записать()
;

