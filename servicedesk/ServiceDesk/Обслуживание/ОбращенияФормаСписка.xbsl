    Позиции.Добавить(ПозПредпочтВремя)
    Позиции.Добавить(ПозПредпочтСотрудник)

    ЗаписатьНастройку(Видимость, Позиции)
;

@НаСервере @ДоступноСКлиента
статический метод ПрочитатьВидимость(): Массив<Булево>?
    знч Профиль = ТекущийПрофиль()
    если Профиль == Неопределено
        возврат Неопределено
    ;

    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Дата,
            Номер,
            Контрагент,
            Направление,
            Срочность,
            Статус,
            Исполнитель,
            КонтактноеЛицо,
            Телефон,
            МобильныйТелефон,
            КодГорода,
            Добавочный,
            НомерВходящий,
            ОбслОрганизация,
            ПользовательОбращения,
            НовыйКонтрагент,
            Уведомление,
            НаправлениеЗаказчика,
            ОписаниеЗаказчика,
            СрочностьЗаказчика,
            ОписаниеИсполнителя,
            ПредпочтДата,
            ПредпочтВремя,
            ПредпочтСотрудник
        ИЗ
            НастройкиКолонокОбращений
        ГДЕ
            Пользователь == %Профиль
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат Неопределено
    ;

    знч Результат = новый Массив<Булево>()
    Результат.Добавить(Строка.Дата)
    Результат.Добавить(Строка.Номер)
    Результат.Добавить(Строка.Контрагент)
    Результат.Добавить(Строка.Направление)
    Результат.Добавить(Строка.Срочность)
    Результат.Добавить(Строка.Статус)
    Результат.Добавить(Строка.Исполнитель)
    Результат.Добавить(Строка.КонтактноеЛицо)
    Результат.Добавить(Строка.Телефон)
    Результат.Добавить(Строка.МобильныйТелефон)
    Результат.Добавить(Строка.КодГорода)
    Результат.Добавить(Строка.Добавочный)
    Результат.Добавить(Строка.НомерВходящий)
    Результат.Добавить(Строка.ОбслОрганизация)
    Результат.Добавить(Строка.ПользовательОбращения)
    Результат.Добавить(Строка.НовыйКонтрагент)
    Результат.Добавить(Строка.Уведомление)
    Результат.Добавить(Строка.НаправлениеЗаказчика)
    Результат.Добавить(Строка.ОписаниеЗаказчика)
    Результат.Добавить(Строка.СрочностьЗаказчика)
    Результат.Добавить(Строка.ОписаниеИсполнителя)
    Результат.Добавить(Строка.ПредпочтДата)
    Результат.Добавить(Строка.ПредпочтВремя)
    Результат.Добавить(Строка.ПредпочтСотрудник)
    возврат Результат
;

