// Обработчики формы «Удаление данных».

метод УдалитьПомеченные(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Результат = "Идёт удаление помеченных объектов..."
    знч Текст = ВыполнитьОчистку()
    Результат = Текст
;

метод ПоказатьПомеченные(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Результат = СписокПомеченных()
;

@НаСервере @ДоступноСКлиента
статический метод СписокПомеченных(): Строка
    знч Текст = новый Массив<Строка>()
    Текст.Добавить("Помечены на удаление:")

    знч ПОбращения = Запрос{
        ВЫБРАТЬ
            Номер,
            Дата
        ИЗ
            Обращения
        ГДЕ
            ПометкаУдаления == Истина
    }
    для Строка из ПОбращения.Выполнить()
        Текст.Добавить("  Обращение №" + Строка.Номер + " от " + Строка.Дата.Представление())
    ;

    знч ПНаряды = Запрос{
        ВЫБРАТЬ
            Номер,
            Дата
        ИЗ
            Наряды
        ГДЕ
            ПометкаУдаления == Истина
    }
    для Строка из ПНаряды.Выполнить()
        Текст.Добавить("  Наряд №" + Строка.Номер + " от " + Строка.Дата.Представление())
    ;

    знч ПКонтрагенты = Запрос{
        ВЫБРАТЬ
            Наименование
        ИЗ
            Контрагенты
        ГДЕ
            ПометкаУдаления == Истина
    }
    для Строка из ПКонтрагенты.Выполнить()
        Текст.Добавить("  Контрагент: " + Строка.Наименование)
    ;

    знч ПДоговоры = Запрос{
        ВЫБРАТЬ
            Наименование
        ИЗ
            Договоры
        ГДЕ
            ПометкаУдаления == Истина
    }
    для Строка из ПДоговоры.Выполнить()
        Текст.Добавить("  Договор: " + Строка.Наименование)
    ;

    возврат Строки.Соединить(Текст, "\n")
;

@НаСервере @ДоступноСКлиента
статический метод ВыполнитьОчистку(): Строка
    знч Процесс = новый УдалениеОбъектов(ТаймаутУстаревания = 0с)
    Процесс.Выполнить()
    возврат "Удаление помеченных объектов запущено. Объекты, на которые есть ссылки, останутся и будут видны в форме управления связями."
;
